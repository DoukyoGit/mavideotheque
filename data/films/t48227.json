Ids":{"imdb_id":"tt0076741","wikidata_id":"Q2897051","facebook_id":null,"instagram_id":null,"twitter_id":null},"keywords":[{"id":3347,"name":"volcano"},{"id":12987,"name":"poverty"},{"id":14796,"name":"destruction"},{"id":221999,"name":"guadeloupe"}],"releaseDates":[{"iso_3166_1":"DE","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Oberhausen","release_date":"1977-04-25T00:00:00.000Z","type":1}]},{"iso_3166_1":"US","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1977-10-01T00:00:00.000Z","type":3}]}],"translations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"La Soufrière: Waiting for an Inevitable Catastrophe","overview":"Werner Herzog takes a film crew to the island of Guadeloupe when he hears that the volcano on the island is going to erupt. Everyone has left, except for one old man who refuses to leave.","tagline":"Waiting for an inevitable disaster"},{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"La Soufrière","overview":"Durant l'été 1976, la ville de Basse-Terre est évacuée car le volcan de la Soufrière est sur le point d'entrer en éruption. Werner Herzog parcourt la ville déserte et décrit la situation.","tagline":""},{"iso_639_1":"es","iso_3166_1":"ES","name":"Español","english_name":"Spanish","title":"La Soufrière","overview":"En 1976 los científicos predijeron que la isla de Guadalupe sería destruida por la erupción del volcán La Soufrière. En plena evacuación, tres hombres se echaron atrás y decidieron quedarse en la isla. Herzog filmó las últimas y fantasmales imágenes de la isla y recogió el testimonio de los hombres que decidieron esperar el fin rodeados por una jauría de perros olvidados. No se pudo rodar el final previsto porque la predicción resultó ser falsa.","tagline":""},{"iso_639_1":"de","iso_3166_1":"DE","name":"Deutsch","english_name":"German","title":"","overview":"„La Soufrière“ ist der Name eines Vulkans auf der Insel Guadelope. 1976 scheint er kurz vor einem Ausbruch zu stehen. Werner Herzog präsentiert kühne Aufnahmen vom Kraterrand und endzeitliche Bilder aus den umliegenden Orten, leere Häuser und ausgestorbene Straßen. Nur ein paar wenige Menschen, die sich der Evakuierung verweigern, sind noch da und werden von Herzog befragt. Doch die „unausweichliche Katastrophe“ tritt nicht ein. Immerhin, stellt Herzog fest: Eine derart gigantische Fehleinschätzung habe es in der Geschichte der Vulkanologie noch nicht gegeben.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"苏弗雷火山","overview":"维尔纳·赫尔佐格听说瓜德罗普岛上的火山即将喷发，便带着摄制组前往该岛。所有人都已撤离，唯有一位老人拒绝离开。","tagline":"等待一场不可避免的灾难。"},{"iso_639_1":"nl","iso_3166_1":"NL","name":"Nederlands","english_name":"Dutch","title":"","overview":"Werner Herzog neemt een filmploeg mee naar het eiland Guadeloupe als hij hoort dat de vulkaan op het eiland gaat uitbarsten. Iedereen is vertrokken, behalve één oude man die weigert te vertrekken.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"蘇弗雷火山","overview":"維爾納·赫爾佐格聽説瓜德羅普島上的火山即將噴發，便帶着攝制組前往該島。所有人都已撤離，唯有一位老人拒絕離開。","tagline":""}],"videos":[],"images":{"posters":[{"file_path":"/yNoPeBRIE4zEgVBpgPLx2n1gNgS.jpg","width":2000,"height":3000,"iso_639_1":"en","vote_average":3.334,"vote_count":1},{"file_path":"/lzUbhGlVd5Iq8ipqVQUGummnwgw.jpg","width":928,"height":1392,"iso_639_1":"en","vote_average":0,"vote_count":0}],"backdrops":[{"file_path":"/2PPhgOQXgophTbWOBnlLIJOJBRC.jpg","width":1280,"height":720,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/4o4cJwOBzG9zwPVqX4wv6fKlljm.jpg","width":1280,"height":720,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/16auhMtgVAykLEmgRdSBaZqcd6w.jpg","width":1280,"height":720,"iso_639_1":"en","vote_average":0,"vote_count":0},{"file_path":"/4ucGPaY9FvAPP6eFOnTMd752ZAq.jpg","width":2520,"height":1418,"iso_639_1":null,