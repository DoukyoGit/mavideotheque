{"id":"t4034","key":"l homme de rio|1964","csv":{"title":"L'Homme de Rio","year":1964,"directors":["Philippe de Broca"],"rating":8,"watchedDate":"2020-11-05"},"status":"ok","tmdb":{"tmdbId":4034,"imdbId":"tt0058203","wikidataId":"Q319171","title":"L'Homme de Rio","originalTitle":"L'Homme de Rio","altTitles":["Der Unverwüstliche","O Homem do Rio","리오에서 온 사나이","L'Homme de rio","Abenteuer in Rio","The Man from Rio"],"tagline":"Regardez ce qu'on appelle une semaine tranquille à Rio !","overview":"Adrien Dufourquet, soldat 2ème classe en permission à Paris, assiste à l’enlèvement de sa fiancée, Agnès. Il se précipite sur la trace des ravisseurs et arrive à Orly. Sans un sou en poche, il monte dans un avion à la suite d’Agnès et se retrouve le lendemain à Rio de Janeiro, pris aussitôt entre la police brésilienne et une effroyable équipe de tueurs…","overviewLang":"fr","releaseDate":"1964-02-05","runtime":120,"status":"Released","genres":["Aventure","Action","Comédie"],"genreIds":[12,28,35],"countries":["Brazil","France","Italy"],"originCountry":["FR"],"languages":["Français","Português"],"originalLanguage":"fr","directors":["Philippe de Broca"],"directorIds":[34613],"writers":["Ariane Mnouchkine","Philippe de Broca","Jean-Paul Rappeneau","Daniel Boulanger"],"composers":["Georges Delerue"],"cinematographers":["Edmond Séchan"],"editors":["Françoise Javet"],"producers":["Alexandre Mnouchkine","Georges Dancigers"],"cast":[{"id":3829,"name":"Jean-Paul Belmondo","character":"Adrien Dufourquet","profilePath":"/hXAM7zTXGWVAv0VLGGrnxAJJbca.jpg"},{"id":18809,"name":"Françoise Dorléac","character":"Agnès Villermosa","profilePath":"/zPAmgTqb1NWBN7NMU1EqnR7PQB.jpg"},{"id":14242,"name":"Jean Servais","character":"Prof. Norbert Catalan","profilePath":"/hrCE3y3ZkYZTx7ISocZOXfIgflF.jpg"},{"id":34615,"name":"Simone Renant","character":"Lola","profilePath":"/uCFsiPGebOk3DhL61XXE6ejbnkn.jpg"},{"id":9920,"name":"Adolfo Celi","character":"Señor Mario De Castro","profilePath":"/bIxjJ4eXYiNrYgSB