ll,"instagram_id":null,"twitter_id":null},"keywords":[{"id":1930,"name":"kidnapping"},{"id":470,"name":"spy"},{"id":1809,"name":"rio de janeiro"},{"id":3379,"name":"diamond mine"},{"id":6956,"name":"treasure hunt"},{"id":5968,"name":"amazon rainforest"},{"id":257940,"name":"chased lovers"},{"id":264118,"name":"brazil"},{"id":287344,"name":"brasília, brazil"},{"id":323404,"name":"ancient artifact"}],"releaseDates":[{"iso_3166_1":"DE","release_dates":[{"certification":"12","descriptors":[],"iso_639_1":"","note":"","release_date":"1964-04-17T00:00:00.000Z","type":3}]},{"iso_3166_1":"FR","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1964-02-05T00:00:00.000Z","type":3}]},{"iso_3166_1":"HU","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"hu","note":"","release_date":"1965-05-20T00:00:00.000Z","type":3}]},{"iso_3166_1":"JP","release_dates":[{"certification":"G","descriptors":[],"iso_639_1":"","note":"","release_date":"1964-10-25T00:00:00.000Z","type":3}]},{"iso_3166_1":"PH","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"RPN 9","release_date":"1983-01-21T00:00:00.000Z","type":6}]}],"translations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"That Man from Rio","overview":"French military man Adrien Dufourquet gets an eight-day furlough to visit his fiancée, Agnès. But when he arrives in Paris, he learns that her late father's partner, museum curator Professor Catalan, has just been kidnapped by a group of Amazon tribesmen who have also stolen a priceless statue from the museum. Adrien and Agnès pursue the kidnappers to Brazil, where they learn that the statue is the key to a hidden Amazon treasure.","tagline":"Look what they call a quiet week in Rio!"},{"iso_639_1":"de","iso_3166_1":"DE","name":"Deutsch","english_name":"German","title":"Abenteuer in Rio","overview":"Soldat Adrien folgt seiner entführten Braut Agnès nach Brasilien. Die kapriziöse Agnès ist einem Geheimnis dreier Statuen auf der Spur und kommandiert den armen Trottel von einem Abenteuer ins nächste.","tagline":""},{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"","overview":"Adrien Dufourquet, soldat 2ème classe en permission à Paris, assiste à l’enlèvement de sa fiancée, Agnès. Il se précipite sur la trace des ravisseurs et arrive à Orly. Sans un sou en poche, il monte dans un avion à la suite d’Agnès et se retrouve le lendemain à Rio de Janeiro, pris aussitôt entre la police brésilienne et une effroyable équipe de tueurs…","tagline":"Regardez ce qu'on appelle une semaine tranquille à Rio !"},{"iso_639_1":"cs","iso_3166_1":"CZ","name":"Český","english_name":"Czech","title":"Muž z Ria","overview":"Francouzský dobrodružný příběh Muž z Ria je jistě jedním z filmových předků Indiana Jonese. Vypráví totiž o neuvěřitelných dobrodružstvích mladého Francouze, pronásledujícího přes celý svět únosce své snoubenky, to vše kvůli bájnému pokladu zmizelé civilizace Malteků. Vojín základní služby Adrien Dufourquet přijíždí na týdenní dovolenou do Paříže za svou snoubenkou Agnes Villermosovou. Ta je však unesena tajemnými muži, kteří pátrají po třech soškách, jediných památkách na ztracenou civilizaci a současně klíčům k bájnému pokladu. Adrien je muž činu a proto se okamžitě vydá únosce pronásledovat. Jeho cesta vede z Paříže do Rio de Janeira, dále do hlavního města Brasilia, do hlubin brazilských pralesů a nakonec zpět do Paříže. To vše v příběhu, kde jedna údálost střídá druhou, scenerie se mění zázračnou rychlostí a hrdina se neustále ocitá v nebezpečí života, z něhož se mu daří uniknout vždy na poslední chvíli, a to jen proto, aby se vzápětí ocitl v dalším ohrožení.","tagline":"Podívejte se, čemu se v Riu říká klidný týden!"},{"iso_639_1":"ru","iso_3166_1":"RU","name":"Pусский","english_name":"Russian","title":"Человек из Рио","overview":"Похищена бесценная индейская статуэтка, а вместе с ней и дочь хозяина сокровища — красавица Аньес. Жених девушки Адриан отправляется в погоню за похитителями. Он не представляет, какие испытания его ждут впереди…","tagline":"«Парашюты... Аллигаторы... Убийцы... Женщины... Думаешь, это легко? Только для такого великого искателя приключений, как я!»"},{"iso_639_1":"it","iso_3166_1":"IT","name":"Italiano","english_name":"Italian","title":"L'uomo di Rio","overview":"Adriano torna a casa in licenza e scopre che la fidanzata Agnese è stata appena rapita. Dopo un inseguimento, raggiunge i rapitori all'aeroporto e prende il loro stesso aereo, diretto a Rio de Janeiro. Qui, dopo mirabolanti avventure, libera Agnese e svela la macchinazione criminale che sta dietro alla faccenda, legata alla scoperta di un'antica civiltà e dei suoi preziosissimi reperti.","tagline":""},{"iso_639_1":"hu","iso_3166_1":"HU","name":"Magyar","english_name":"Hungarian","title":"Riói kaland","overview":"Adrien, az egyhetes eltávozáson lévő katona Párizsba megy, hogy meglátogassa menyasszonyát. Agnes apját három évvel korábban meggyilkolták egy rejtélyes agyagszobrocska miatt, amely egy letűnt civilizáció egyik utolsó ereklyéje volt. A lányt egy muzeológussal együtt fegyveresek elrabolják és Brazíliába hurcolják. Adrien repülővel, hidroplánnal, hajóval, biciklivel, gyalogosan üldözőbe veszi a rablókat, hogy kiszabadítsa szívszerelmét. Sok-sok izgalmas és mulatságos kaland után fény derül a rejtélyes agyagszobrok titkára.","tagline":""},{"iso_639_1":"es","iso_3166_1":"ES","name":"Español","english_name":"Spanish","title":"El hombre de Río","overview":"El soldado francés Adrien Dufourquet está a punto de pasar una semana de permiso más ajetreada de lo esperable. Mientras se dirige a París para visitar a su novia, se produce el robo de una estatuilla de origen amazónico en el Museo del Hombre de la capital. Los ladrones se llevan, además, al profesor Chatillón, miembro de la expedición que halló el objeto, y a su novia. Cuando Adrien aterriza en París tiene que seguir el rastro de los secuestradores hasta Río, Brasilia y el corazón del Amazonas.","tagline":""},{"iso_639_1":"uk","iso_3166_1":"UA","name":"Український","english_name":"Ukrainian","title":"Людина з Ріо","overview":"Викрадена безцінна індіанська статуетка, а разом з нею і дочка господаря скарбу - красуня Аньєс. Наречений дівчини Адріан відправляється в погоню за викрадачами. Він не уявляє, які випробування його чекають попереду...","tagline":""},{"iso_639_1":"nl","iso_3166_1":"NL","name":"Nederlands","english_name":"Dutch","title":"That Man from Rio","overview":"Uitgerekend wanneer soldaat Adrien Dufourquet (Belmondo) zijn week verlof bij zijn Parijse vriendin Agnés (Dorléac) wil doorbrengen, wordt ze gekidnapt. Heeft hij weer. Hij volgt haar spoor naar Brazilië en geleidelijk aan wordt duidelijk, dat de ontvoering alles te maken heeft met een verdwenen beeldje, afkomstig uit het Amazone-gebied.","tagline":"Kijk eens hoe ze een rustige week in Rio noemen!"},{"iso_639_1":"pt","iso_3166_1":"BR","name":"Português","english_name":"Portuguese","title":"O Homem do Rio","overview":"O roubo de uma relíquia de antiga civilização desencadeia uma série de aventuras envolvendo morte e sequestro. Agnes, a filha de um homem assassinado, é sequestrada, drogada e enviada para o Rio de Janeiro em um avião. Seu namorado Adrien, um soldado, procura a amada, seguindo uma jornada pelo Rio, Brasília e Amazônia.","tagline":""},{"iso_639_1":"bg","iso_3166_1":"BG","name":"български език","english_name":"Bulgarian","title":"Човекът от Рио","overview":"Френският военен Адриен Дюфуркет получава осемдневна отпуска за да се види с годеницата си Агнес. Когато пристига в Париж, той научава, че партньора на покойния й баща - музейният куратор професор Каталан - тъкмо е бил отвлечен от  членове на племе от Амазония, които освен това са откраднали и безценна статуя от музея. Двамата с Агнес се впускат в преследване на професора и статуята в Бразилия, където научават, че статуята е ключ към скрито амазонско съкровище.","tagline":""},{"iso_639_1":"ko","iso_3166_1":"KR","name":"한국어/조선말","english_name":"Korean","title":"리오에서 온 사나이","overview":"프랑스의 한 박물관에서 말타 문명의 조각상이 도난 당하는 사건이 발생한다. 원래 이 조각상은 3개가 한 세트인데, 이 조각상을 발견한 고고학자와 수집가가 각각 소유하고 있던 것이다. 여주인공 아그네스가 고고학자였던 아버지의 유언으로 조각상 하나의 행방을 알고 있었고, 그녀는 박물관에서 조각상을 훔쳤던 집단에 의해 납치를 당한다. 이때 마침 휴가를 나온 아그네스의 약혼자이자 공군 파일롯인 애드리안 (장 폴 벨몽도)가 아그네스를 쫓아 그녀가 납치된 브라질의 리오에서 모험을 펼친다는 내용이다.","tagline":""},{"iso_639_1":"pl","iso_3166_1":"PL","name":"Polski","english_name":"Polish","title":"Człowiek z Rio","overview":"Farsa szpiegowska i przygodowa. Śniadzi obcokrajowcy, zdający się wręcz niezniszczalni i używający zatrutych strzałek, kradną amazońską statuetkę z paryskiego muzeum i uprowadzają znawców w dziedzinie wymarłej cywilizacji Malteków. Jest wśród nich Agnes, córka zamordowanego profesora, posiadacza jednej z trzech figurek Malteków. Jej chłopak, Adrien, przebywający w Paryżu na tygodniowej przepustce z koszar, wiedząc, że na policje nie ma co liczyć rzuca się w szalony pościg. Porywacze zabierają odurzoną narkotykami Agnes do samolotu do Rio. Adrien, wspomagany przez miejscowego pucybuta, aby ocalić ekscentryczną dziewczynę, powstrzymać bezwzględnych złodzieji i przy okazji poznać tajemnicę Malteków, będzie musiał przemierzyć Rio, Brasílię i dżunglę Amazonii. . . wszystko zanim zostanie uznany za dezertera.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"里奥追踪","overview":"　　法国动作巨星贝尔蒙多最走红时主演了这部节奏紧凑利落的冒险动作片，在片中饰演介乎詹姆斯·邦德与印第安那·琼斯的英雄，负责找寻被盗取的巴西珍贵古物，经过一连串的追踪、打斗和揭发内奸的行动，终于完成了任务。全片娱乐元素丰富，贝尔蒙多充分发挥其敏捷身手，演出了不少紧张刺激的动作场面。导演在优秀的摄影师协助下，跨国拍摄了优美的地域风光，使影片增色不少，同时在悬念与动作之外也有轻松惹笑的趣味平衡气氛，堪称是一部成功的法式喜剧动作片。在60年代，本片是法国乃至欧洲影坛少数能与好莱坞产品在商业和票房上相抗衡之作。","tagline":""},{"iso_639_1":"el","iso_3166_1":"GR","name":"ελληνικά","english_name":"Greek","title":"Ο Τυχοδιώκτης του Ρίο","overview":"Κάτι ληστές κλέβουν ένα αγαλματάκι από ένα μουσείο του Παρισιού. Μαζί θα απαγάγουν και κάποιο καθηγητή. Ο Μπελμοντό μπλέκεται όταν οι απαγωγείς απάγουν και την αγαπημένη του.","tagline":""},{"iso_639_1":"ka","iso_3166_1":"GE","name":"ქართული","english_name":"Georgian","title":"კაცი რიოდან","overview":"მოიპარეს ფასდაუდებელი ინდური ფიგურა და მასთან ერთად განძის მფლობელის, მშვენიერი აგნესის ქალიშვილი. გოგონას საქმრო ადრიანი მიემართება გამტაცებლების დევნაში. მას წარმოდგენაც არ აქვს, რა განსაცდელები ელის წინ...","tagline":""},{"iso_639_1":"ja","iso_3166_1":"JP","name":"日本語","english_name":"Japanese","title":"リオの男","overview":"フランスを代表するスーパースター、ベルモンドの十八番、アクション・コメディー「男シリーズ」の記念すべき第1作。\r アクション映画の醍醐味でもあるスリルとアクション、追いつ追われつのサスペンスを、ノンストップで描いた最高傑作の誉れ高い快作。","tagline":""},{"iso_639_1":"fi","iso_3166_1":"FI","name":"suomi","english_name":"Finnish","title":"Mies Riosta","overview":"","tagline":""},{"iso_639_1":"lt","iso_3166_1":"LT","name":"Lietuvių","english_name":"Lithuanian","title":"Žmogus iš Rio","overview":"Jaunas vyriškis atvyksta išvaduoti savo merginą, kurią pagrobė vagys ir atvežė į Rio. Prasideda ekstravagantiškas nuotykis...","tagline":""},{"iso_639_1":"sk","iso_3166_1":"SK","name":"Slovenčina","english_name":"Slovak","title":"Muž z Ria","overview":"Francúzsky dobrodružný príbeh Muž z Ria je iste jeden z filmových predkov Indiana Jonesa. Rozpráva totiž o neuveriteľných dobrodružstvách mladého Francúza, prenasledujúceho cez celý svet únoscov svojej snúbenice, to všetko kvôli bájnemu pokladu zmiznutej civilizácie Maltekov. Vojak základnej služby Adrien Dufourquet prichádza na týždennú dovolenku do Paríža za svojou snúbenicou Agnes Villermosovou. Tá je však unesená tajomnými mužmi, ktorí pátrajú po troch soškách, jediných pamiatkach na stratenú civilizáciu a súčasne kľúčom k bájnemu pokladu. Adrien je muž činu a preto sa okamžite vydá únoscov prenasledovať. Jeho cesta vedia z Paríža do Rio de Janeiro, ďalej do hlavného mesta Brasília, do hlbín brazílskych pralesov a nakoniec späť do Paríža. To všetko v príbehu, kde jedna udalosť strieda druhú, scenérie sa menia zázračnou rýchlosťou a hrdina sa neustále ocitá v ohrození života, z ktorého sa mu darí uniknúť vždy na poslednú chvíľu, a to preto, aby sa vzápätí ocitol v ďalšom ohrození.","tagline":""},{"iso_639_1":"sv","iso_3166_1":"SE","name":"svenska","english_name":"Swedish","title":"Mannen från Rio","overview":"","tagline":""},{"iso_639_1":"da","iso_3166_1":"DK","name":"Dansk","english_name":"Danish","title":"Orlov i Rio","overview":"Soldaten Adrien får orlov, så han sætter kurs mod Paris for at se sin kæreste. Desværre bliver hun bortført for øjnene af ham af et par indianere, der tror, at hun kan føre dem til en enorm skat. Adrien optager straks forfølgelse, og det sender ham ud på et vildt eventyr, der bringer ham til både Rio og Amazonjunglen.","tagline":""},{"iso_639_1":"ca","iso_3166_1":"ES","name":"Català","english_name":"Catalan","title":"L’home de Rio","overview":"","tagline":""},{"iso_639_1":"ro","iso_3166_1":"RO","name":"Română","english_name":"Romanian","title":"Acel bărbat din Rio","overview":"Adrien asistă la răpirea lui Agnès, logodnica sa. Aceasta are loc după dispariția unei statuete amazoniene și a etnologului, tutorele lui Agnès, care o adusese din Brazilia. În urmărirea răpitorilor, Adrien se îmbarcă clandestin într-un avion cu destinația... Rio de Janeiro.","tagline":""},{"iso_639_1":"et","iso_3166_1":"EE","name":"Eesti","english_name":"Estonian","title":"Mees Riost","overview":"Varastati hindamatu India kuju ja koos sellega ka aarde omaniku tütar kaunis Agnes. Tüdruku kihlatu Adrian asub röövijaid jälitama. Tal pole aimugi millised katsumused ees ootavad.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"里奧追蹤","overview":"法國動作巨星貝爾蒙多最走紅時主演了這部節奏緊湊利落的冒險動作片，在片中飾演介乎占士·邦與印第安那·瓊斯的英雄，負責找尋被盜取的巴西珍貴古物，經過一連串的追蹤、打鬥和揭發內奸的行動，終於完成了任務。全片娛樂元素豐富，貝爾蒙多充分發揮其敏捷身手，演出了不少緊張刺激的動作場面。導演在優秀的攝影師協助下，跨國拍攝了優美的地域風光，使影片增色不少，同時在懸念與動作之外也有輕松惹笑的趣味平衡氣氛，堪稱是一部成功的法式喜劇動作片。在 60 年代，本片是法國乃至歐洲影壇少數能與好萊塢產品在商業和票房上相抗衡之作。","tagline":""},{"iso_639_1":"sr","iso_3166_1":"RS","name":"Srpski","english_name":"Serbian","title":"Човек из Рија","overview":"Француски војник Адријен стиже у Париз на седмодневни одсут, али његова вереница Ањес бива киднапована одмах након крађе вредне индијанске статуе из музеја. Пратећи отмичаре без новца и кофера, Адријен се укрцава на авион за Бразил и упада у вртоглаву потеру кроз Рио де Жанеиро и прашуме Амазоније. Да би спасио Ањес и спречио крадљивце да се домогну древног блага, он мора да изведе серију сулудих каскадерских подухвата пре него што му истекне војно одсуство.","tagline":""},{"iso_639_1":"lv","iso_3166_1":"LV","name":"Latviešu","english_name":"Latvian","title":"Vīrs no Rio","overview":"","tagline":""}],"videos":[{"key":"Tlqg5wn4dSE","site":"YouTube","type":"Featurette","name":"Josh Olson on THAT MAN FROM RIO","iso_639_1":"en","official":false,"published_at":"2015-07-13T01:24:22.000Z","size":1080},{"key":"ceB4bqJVEYg","site":"YouTube","type":"Trailer","name":"That Man From Rio - Restoration Trailer","iso_639_1":"en","official":true,"published_at":"2014-08-08T16:58:37.000Z","size":1080},{"key":"-JmQO5BAT0k","site":"YouTube","type":"Trailer","name":"L'HOMME DE RIO de Philippe de Broca - Official Trailer - 1964","iso_639_1":"fr","official":false,"published_at":"2013-05-13T15:57:58.000Z","size":720}],"images":{"posters":[{"file_path":"/AhaUqqHTIMSXG6WOMRCreitQ1ZX.jpg","width":2000,"height":3000,"iso_639_1":"en","vote_average":3.334,"vote_count":1},{"file_path":"/33Fe3pZs3PTfHoK9mSbcIG3Bz7j.jpg","width":2000,"height":3000,"iso_639_1":"fr","vote_average":3.334,"vote_count":1},{"file_path":"/v5Y6lXkrvhAMuNBtaLYecSQtoud.jpg","width":1707,"height":2560,"iso_639_1":"en","vote_average":2.542,"vote_count":4},{"file_path":"/q52OHSrGDRaGKIcOgTKVxYpfSaa.jpg","width":748,"height":1024,"iso_639_1":"fr","vote_average":2.278,"vote_count":3},{"file_path":"/kfEprEnumoOlsSK210Ai45JevlE.jpg","width":1400,"height":2100,"iso_639_1":"fr","vote_average":2.278,"vote_count":3},{"file_path":"/rYagiP1TfTpHITL5tXTFiqfsyQl.jpg","width":1000,"height":1500