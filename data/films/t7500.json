original_name":"織田尚","job":"Makeup Artist","department":"Costume & Make-Up","gender":2,"profile_path":null},{"id":3317,"name":"Takeshi Kitano","original_name":"ビートたけし","job":"Screenplay","department":"Writing","gender":2,"profile_path":"/6pnXXkCx8wkCHvOrcWjaY58KA7k.jpg"},{"id":4998,"name":"柳島克己","original_name":"柳島克己","job":"Director of Photography","department":"Camera","gender":2,"profile_path":"/uZS5hCD2Ji89gUDaODuFN4T4gDn.jpg"},{"id":636,"name":"Joe Hisaishi","original_name":"久石譲","job":"Original Music Composer","department":"Sound","gender":2,"profile_path":"/xmDT8LoDPIyV4f7Q2yPwETSey6k.jpg"},{"id":1684747,"name":"Toshihiro Tenma","original_name":"Toshihiro Tenma","job":"Assistant Director","department":"Directing","gender":2,"profile_path":null},{"id":146663,"name":"Hitoshi Takaya","original_name":"高屋齋","job":"Gaffer","department":"Lighting","gender":2,"profile_path":null},{"id":4999,"name":"太田義則","original_name":"太田義則","job":"Assistant Editor","department":"Editing","gender":2,"profile_path":"/zgQljdFXKZSFWBJijk9jLOTBTSr.jpg"}]},"alternativeTitles":[{"iso_3166_1":"CN","title":"小奏鸣曲","type":""},{"iso_3166_1":"BR","title":"Adrenalina Máxima","type":""},{"iso_3166_1":"KR","title":"소나티네","type":""},{"iso_3166_1":"HK","title":"奏鳴曲","type":""},{"iso_3166_1":"JP","title":"ソナチネ","type":""},{"iso_3166_1":"US","title":"Sonatine","type":""},{"iso_3166_1":"SA","title":"سوناتين","type":"Arabic title"},{"iso_3166_1":"BG","title":"Сонатина","type":""},{"iso_3166_1":"LV","title":"Sonachine","type":""},{"iso_3166_1":"HU","title":"Szonatina","type":""}],"externalIds":{"imdb_id":"tt0108188","wikidata_id":"Q1339178","facebook_id":null,"instagram_id":null,"twitter_id":null},"keywords":[{"id":233,"name":"japan"},{"id":966,"name":"beach"},{"id":1794,"name":"yakuza"},{"id":4728,"name":"knife"},{"id":8676,"name":"okinawa"},{"id":10580,"name":"russian roulette"},{"id":14677,"name":"bullet wound"},{"id":163656,"name":"gun violence"},{"id":215449,"name":"playfulness"},{"id":281869,"name":"fatalism"},{"id":319417,"name":"yakuza eiga"}],"releaseDates":[{"iso_3166_1":"DE","release_dates":[{"certification":"18","descriptors":[],"iso_639_1":"","note":"","release_date":"1998-05-21T00:00:00.000Z","type":3}]},{"iso_3166_1":"ES","release_dates":[{"certification":"18","descriptors":[],"iso_639_1":"","note":"","release_date":"1995-02-03T00:00:00.000Z","type":3}]},{"iso_3166_1":"FR","release_dates":[{"certification":"12","descriptors":[],"iso_639_1":"","note":"Cannes Film Festival","release_date":"1993-05-15T00:00:00.000Z","type":1},{"certification":"12","descriptors":[],"iso_639_1":"","note":"Cognac Detective Film Festival","release_date":"1995-04-06T00:00:00.000Z","type":3},{"certification":"12","descriptors":[],"iso_639_1":"","note":"","release_date":"1995-05-03T00:00:00.000Z","type":3}]},{"iso_3166_1":"GB","release_dates":[{"certification":"18","descriptors":[],"iso_639_1":"","note":"","release_date":"1993-09-23T00:00:00.000Z","type":3}]},{"iso_3166_1":"IT","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Taormina Film Festival","release_date":"1993-07-27T00:00:00.000Z","type":1},{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"2000-06-16T00:00:00.000Z","type":3}]},{"iso_3166_1":"JP","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1993-06-05T00:00:00.000Z","type":1},{"certification":"R-15","descriptors":[],"iso_639_1":"","note":"","release_date":"1993-09-10T00:00:00.000Z","type":3}]},{"iso_3166_1":"KR","release_dates":[{"certification":"19","descriptors":[],"iso_639_1":"","note":"","release_date":"2000-01-08T00:00:00.000Z","type":3}]},{"iso_3166_1":"NL","release_dates":[{"certification":"16","descriptors":[],"iso_639_1":"","note":"","release_date":"1994-09-15T00:00:00.000Z","type":3},{"certification":"16","descriptors":[],"iso_639_1":"","note":"DVD","release_date":"2008-09-20T00:00:00.000Z","type":5}]},{"iso_3166_1":"US","release_dates":[{"certification":"R","descriptors":[],"iso_639_1":"","note":"","release_date":"1998-04-10T00:00:00.000Z","type":3}]}],"translations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"","overview":"Murakawa, an aging Tokyo yakuza tiring of gangster life, is sent by his boss to Okinawa along with a few of his henchmen to help end a gang war, supposedly as mediators between two warring clans. He finds that the dispute between the clans is insignificant and whilst wondering why he was sent to Okinawa at all, his group is attacked in an ambush. The survivors flee and make a decision to lay low at the beach while they await further instructions.","tagline":"A ferocious man sleeps here."},{"iso_639_1":"it","iso_3166_1":"IT","name":"Italiano","english_name":"Italian","title":"Sonatine","overview":"Murakawa è uno Yakuza che sta per ritirarsi e viene inviato in missione a Okinawa. Lì giunto gioca sulla spiaggia con i suoi aiutanti e incontra una ragazza che è stata stuprata. Quando capisce di essere stato tradito va incontro al proprio destino. Film fondamentale nella filmografia di Kitano. Uscito nel 1993 e premiato al festival di Taormina, è uscito nelle sale solo dopo Hana-Bi e L'estate di Kikujiro. Comicità, durezza, poesia. Un cinema finalmente diverso dalla cinematografia nipponica.","tagline":""},{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"Sonatine, mélodie mortelle","overview":"Murakawa, le bras droit du chef yakuza Kitakima est appelé d'urgence afin venir en aide au clan Anan en guerre contre un clan rival. Murakawa qui était sur le point de prendre sa retraite perd plusieurs hommes après un attentat à la bombe et une fusillade. Pour se protéger, il se réfugie sur Okinawa avec quelques hommes dans une maison au bord de la mer, le temps que les choses se calment. Dans les premiers temps, ils s'ennuient et tentent de se divertir par plusieurs moyens, mais rapidement sous l'impulsion de leur chef, ces anciens yakuzas vont apprendre à s'occuper et à vivre simplement. Murakawa quant à lui, homme fatigué et désabusé, va réapprendre à profiter du moment présent grâce à cette pause improvisée. Il ignore pourtant que pendant ce temps là, son chef est en train d’opérer un rapprochement stratégique avec le groupe rival, alors lorsqu'il découvre la vérité il décide de se venger et abat tous ceux qui l'ont trahi.","tagline":""},{"iso_639_1":"ru","iso_3166_1":"RU","name":"Pусский","english_name":"Russian","title":"Сонатина","overview":"Герой фильма — гангстер Муракава, руководитель среднего звена Токийской якудзы. Когда на Окинаве начинается жестокая война между бандитскими кланами, большой босс принимает решение послать «бригаду» Муракавы для урегулирования конфликта. В последний раз, когда Муракава выполнял подобную работу, трое из его ребят погибли. Но делать нечего: приказы в якудзе не обсуждаются. Однако, интуиция опытного и бывалого гангстера подсказывает Муракаве, что на этот раз тремя мертвецами он не отделается…","tagline":""},{"iso_639_1":"de","iso_3166_1":"DE","name":"Deutsch","english_name":"German","title":"","overview":"Unterwelt-Bigshot Murakawa soll im Auftrag seines Bosses im fernen Okinawa geschäftliche Unstimmigkeiten klären. Dort liegen zwei verfeindete Familien im Streit, eine Partei davon pflegt beste Kontakte zur Yakuza-Familie in Tokio und bittet um Hilfe durch die Mutterorganisation. Scheinbar. Begleitet von einer Truppe unmotivierter Anfänger reist Murakawa nach Okinawa und gerät unversehens zwischen die Fronten intriganter Unterweltclans. Ein blutiges und offensichtlich auswegloses Abenteuer nimmt seinen Lauf.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"奏鸣曲","overview":"　　北岛组干部村川（北野武 饰）因与大老板（逗子とんぼ 饰）关系不佳，而被派去冲绳协助兄弟帮派对抗阿南组。村川等人的到来似乎激化了原有的矛盾，双方对抗不断升级。在一次酒吧枪战中，村川的手下中弹身亡，随后他与手下片桐（大杉涟 饰）、肯（寺道进 饰）等人躲到海边小屋中暂避风头。\r 　　在金黄的沙滩上，这群经历了血雨腥风的大男人们玩起了充满童真的游戏。然而他们的逍遥快活无法持续太久，北岛组和阿南组秘密联合，意欲将村川等人彻底铲除……\r 　　本片荣获1994年日本电影学院奖最佳电影原声、1995年法国干邑影展影评人奖。","tagline":"一个凶猛的男人长眠于此。"},{"iso_639_1":"es","iso_3166_1":"ES","name":"Español","english_name":"Spanish","title":"","overview":"Murakawa (Kitano) es un yakuza de Tokyo que es enviado por su jefe a terminar una guerra de gángsters en Okinawa. (FILMAFFINITY)","tagline":""},{"iso_639_1":"pt","iso_3166_1":"PT","name":"Português","english_name":"Portuguese","title":"Adrenalina Máxima","overview":"Murakawa é um típico representante da Yakuza, um gângster violento, impiedoso e urbano, morador de Tóquio. Poucos poderiam imaginar, mas ele está cansado de seu estilo de vida. Uma oportunidade de mudança de ares, porém, acaba surgindo. Seus serviços são requisitados para dar reforço a um bando sediado na ilha de Okinawa, ao sul do arquipélago japonês. Nestes dois momentos da vida de Murakawa, entre a crueza do ambiente das grandes cidades e a impávida tranquilidade do mar, estão representadas as forças que lutam dentro do coração do homem.","tagline":""},{"iso_639_1":"ja","iso_3166_1":"JP","name":"日本語","english_name":"Japanese","title":"ソナチネ","overview":"沖縄へ助っ人に向かったヤクザの村川と北島組の面々。彼らはそこで自分たちを標的にした罠にかかったことを知る。最果ての南の島で死に怯える男たちだが、確実に無常に、本人にとっては唐突に処分されていく。そんな極限状況の中で村川だけは都会の生活で失った感情を取り戻すかのように動き回り、刹那的な笑いや恥らいといった心の揺れを求めていく。","tagline":"凶暴な男、ここに眠る。"},{"iso_639_1":"pl","iso_3166_1":"PL","name":"Polski","english_name":"Polish","title":"Sonatina","overview":"Film opowiada o ostatnich dniach życia tokijskiego członka yakuzy Murakawy. Zostaje on wysłany na wyspę Okinawę, gdzie ma zapobiec wojnie gangów. Jednak kiedy dociera na miejsce, sytuacja drastycznie się pogarsza, a on i jego ludzie dostają się pod ogień krzyżowy. Gangsterzy z Tokyo przechodzą do ofensywy. Jednak ich czas życia nieubłaganie mija...","tagline":""},{"iso_639_1":"hu","iso_3166_1":"HU","name":"Magyar","english_name":"Hungarian","title":"Szonatina","overview":"Murakava (Takeshi Kitano) a tokiói jakuza egyik legmegbízhatóbbtagja. A főnökök ugyanakkor tartanak is tőle, féltve hatalmukat. Ezért amikor Okinava-ban kitör a háború két rivális banda között, Murakava-t és embereit küldik el rendet csinálni, abban a reményben, hátha nem mindegyikük tér vissza élve erről a küldetésről... A Szonatina ízig-vérig igazi Takeshi Kitano film. Megtalálható benne a rá jellemző brutalitás, de emellett rajta kívül szinte senki más nem képes így ábrázolni ezeknek a kegyetlen gengsztereknek a lelki világát, illetve a japánok - legalábbis európai szemmel nézve - különös viszonyát a halálhoz.","tagline":""},{"iso_639_1":"he","iso_3166_1":"IL","name":"עִבְרִית","english_name":"Hebrew","title":"סונטינה","overview":"מוראקאווה הוא איש יאקוזה ידוע לשמצה ברחבי טוקיו. כאשר פורצת מלחמת כנופיות באוקינאווה הוא נשלח עם כמה מחייליו להשליט סדר. כבר עם הגיעו נראה כי משהו פה מסריח. כמה מאנשיו נהרגים בפצצה שהונחה במשרדיו, אחרים נהרגים בהתקפה מזוינת על באר מקומי. מוראקאווה אוסף את שארית אנשיו, מוצא מקלט בבית חוף מבודד, וממתין להוראות נוספות מהפיקוד בטוקיו. כאן מוצאת החבורה מפלט מהשעמום במשחקי קלפים או פריסבי, ברולטה רוסית, בשעשועי סומו, ועוד. הגנגסטר המנוסה אפילו פוצח במערכת יחסים עם אישה שאותה הציל מאונס אכזרי בידי בעלה. אבל אצל טאקשי כמו אצל טאקשי ? את האידיליה יפוגג פרץ","tagline":""},{"iso_639_1":"ko","iso_3166_1":"KR","name":"한국어/조선말","english_name":"Korean","title":"소나티네","overview":"야쿠자들의 동경 생활은 비지니스맨이나 샐러리맨들처럼 규칙적이며 사무적이다. 그 중에서 무라카와는 눈 한번 깜짝하지 않고 사람을 기중기에 매달아 강물에 처넣는 프로페셔널한 야쿠자이다. 야쿠자 집단의 내분으로 인해 오키나와 해변의 허름한 집에 머물게 된 무라카와와 그의 부하들은 천진난만한 동심의 세계로 돌아간다. 한가하게 종이인형으로 스모를 하거나 권총으로 러시안 룰렛을 즐기며 시간을 보내는 무라카와. 한편 야쿠자들의 음모가 비밀리에 진행되면서 낚시꾼으로 위장한 킬러가 오키나와 해변으로 찾아오는데...","tagline":"거칠 것 없는 야쿠자가 들려주는 삶의 변주곡"},{"iso_639_1":"nl","iso_3166_1":"NL","name":"Nederlands","english_name":"Dutch","title":"","overview":"Sonatine speelt zich af in de wereld van Yakuza, de Japanse onderwereld. Hier heeft Murakawa de reputatie een van de hardste en gewelddadigste gangsters van Tokio te zijn. Hij wil gepast afscheid nemen met een laatste eervolle opdracht.","tagline":""},{"iso_639_1":"sv","iso_3166_1":"SE","name":"svenska","english_name":"Swedish","title":"Sonatine","overview":"En ledare för den japanska maffian, den s.k. Yakuzan, eordras av den högsta bossen i Tokyo att tillsammans med sina närmaste män bege sig till Okinawa för att lösa en tvist mellan rivaliserande gangstergäng. Han misstänker redan från början att något inte står rätt till, och efter bara några dagar hittar han sina män kallblodigt mördade. Han förstår att hela uppdraget bara var en fälla för att kunna döda hans män och ta över hans eftertraktade territorium.  Nu är han helt ensam, och den enda möjligheten att överleva är att hämnas på dem som lurat in honom i detta dödliga dubbelspel.","tagline":""},{"iso_639_1":"el","iso_3166_1":"GR","name":"ελληνικά","english_name":"Greek","title":"Σονατίνα","overview":"Ένας γιακούζα μπαίνει ανάμεσα σε δυο αντιμαχόμενες συμμορίες, προδίδεται από το αφεντικό του και παίρνει την εκδίκησή του.","tagline":""},{"iso_639_1":"uk","iso_3166_1":"UA","name":"Український","english_name":"Ukrainian","title":"Сонатіна","overview":"Це одна із найкращих картин чудового японського актора й режисера Такесі Кітано. Герой фільму - гангстер Муракава, керівник середньої ланки Токійської якудзи. Коли на Окінаві починається жорстока війна між бандитськими кланами, великий бос вирішує послати бригаду Муракави для врегулювання конфлікту...","tagline":""},{"iso_639_1":"zh","iso_3166_1":"TW","name":"普通话","english_name":"Mandarin","title":"奏鳴曲","overview":"北野武扮演心狠心辣的大哥村川，厭倦了江湖打打殺殺，決定退隱江湖，沒想到大老板卻在此時交給他一項任務，要前去解決另一組人馬的老大，不得已的他只好帶著小弟前往殺敵，一路上他遇到許多突發狀況與麻煩，遭到埋伏的一群人一度躲在小屋內耗時間，躲警察玩著幼稚的遊戲...\r 村川很快發現大老板意圖削弱他的勢力，將忠心的他當作眼中釘，擔心村川會竄位，於是以任務之名要殺他滅口，最後村川與唯一僅存的手下，殺回堂口，全身而退的他，卻在回程途中舉槍自殺...","tagline":""},{"iso_639_1":"vi","iso_3166_1":"VN","name":"Tiếng Việt","english_name":"Vietnamese","title":"Chiến Tranh Băng Đảng","overview":"","tagline":""},{"iso_639_1":"pt","iso_3166_1":"BR","name":"Português","english_name":"Portuguese","title":"Adrenalina Máxima","overview":"Murakawa, um velho yakuza de Tóquio cansado da vida de gângster, é enviado por seu chefe a Okinawa com alguns de seus capangas para ajudar a acabar com uma guerra de gangues, supostamente como mediador entre dois clãs em conflito. Ele descobre que a disputa entre os clãs é insignificante e, enquanto se pergunta por que foi enviado a Okinawa, seu grupo é atacado em uma emboscada. Os sobreviventes fogem e decidem se esconder na praia enquanto aguardam novas instruções.","tagline":"Um homem feroz dorme aqui."},{"iso_639_1":"cs","iso_3166_1":"CZ","name":"Český","english_name":"Czech","title":"","overview":"Hypnotický yakuza film od Takeshiho Kitana, který režíroval, napsal, sestříhal a ve kterém také hraje hlavní roli. Příběh sleduje unaveného tokijského gangstera Murakawu, kterého jeho šéf pošle na Okinawu vyřešit údajný spor mezi místními klany. Když ale válka eskaluje a Murakawa začne tušit, že ho jeho vlastní šéf chce nechat zabít, rozhodne se se svou skupinou přečkat nebezpečí na odlehlé pláži.\r Film představuje dokonalou ukázku Kitanova jedinečného stylu - kombinuje šokující násilí s neemočními reakcemi postav, pomalé tempo s nečekanými výbuchy akce. Pesimistický příběh o únavě ze života a nevyhnutelnosti osudu je vyprávěn s charakteristickou odtažitostí a suchým humorem.\r Sonatine se stal jedním z nejúspěšnějších a nejchválenějších filmů Takeshiho Kitana a získal mu početnou mezinárodní fanouškovskou základnu. Ačkoliv to byl teprve jeho čtvrtý režijní počin, je považován za jeden z nejlepších filmů tohoto vizionářského tvůrce.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"奏鳴曲","overview":"北野武扮演心狠心辣的大哥村川，厭倦了江湖打打殺殺，決定退隱江湖，沒想到大老闆卻在此時交給他一項任務，要前去解決另一組人馬的老大，不得已的他只好帶著小弟前往殺敵，一路上他遇到許多突發狀況與麻煩，遭到埋伏的一群人一度躲在小屋內耗時間，躲警察玩著幼稚的遊戲. . . 村川很快發現大老闆意圖削弱他的勢力，將忠心的他當作眼中釘，擔心村川會竄位，於是以任務之名要殺他滅口，最後村川與唯一僅存的手下，殺回堂口，全身而退的他，卻在回程途中舉槍自殺. . .","tagline":""},{"iso_639_1":"sk","iso_3166_1":"SK","name":"Slovenčina","english_name":"Slovak","title":"Sonatine","overview":"Murakami je zabijak. Rozmýšľa o dôchodku, ale predsa len príjme ponuku na vyriešenie sporov medzi dvoma gangamy. Zoberie si svojich najbližších ľudí a vydá sa situáciu vyriešiť. Lenže svojim príchodom vyprovokuje gangy, medzi ktorými vypukne vojna. Kvôli bezpečiu sa hrdinovia tohoto snímku schovajú v domčeku na pláži a čakajú na ďalšie pokyny. Lenže gangy na nich vyslali nájomného zabijaka.","tagline":"Tu spí zúrivý muž."},{"iso_639_1":"ar","iso_3166_1":"SA","name":"العربية","english_name":"Arabic","title":"","overview":"يُرسل زعيم من عصابة الياكوزا في طوكيو، سئم حياة الجريمة، إلى أوكيناوا للتوسط في نزاع بين عصابتين. لكن المهمة تتحول إلى فخ دموي، فيلجأ مع رجاله إلى منزل منعزل على الشاطئ بانتظار ما سيحدث.","tagline":""}],"videos":[{"key":"0wVDvXM6kjY","site":"YouTube","type":"Featurette","name":"Nihilism and violence in Sonatine | BFI video essay","iso_639_1":"en","official":true,"published_at":"2020-06-25T13:39:28.000Z","size":1080},{"key":"nFJ1YewFjSM","site":"YouTube","type":"Clip","name":"Sonatine (1993) clip - on BFI Blu-ray from 29 June 2020 | BFI","iso_639_1":"en","official":true,"published_at":"2020-05-27T09:36:51.000Z","size":1080},{"key":"gsx6RykyX7o","site":"YouTube","type":"Trailer","name":"Sonatine, mélodie mortelle (Bande annonce Vostfr)","iso_639_1":"fr","official":false,"published_at":"2019-09-25T11:04:43.000Z","size":480},{"key":"oLcZFTPZKfc","site":"YouTube","type":"Trailer","name":"Sonatine - Trailer","iso_639_1":"en","official":true,"published_at":"2012-12-06T05:15:07.000Z","size":480}],"images":{"posters":[{"file_path":"/mX9E4fEuG17L2e7bZmhBc0XdRbw.jpg","width":1200,"height":1800,"iso_639_1":"en","vote_average":5.25,"vote_count":8},{"file_path":"/pnIpqoDTgHvTHK1QZlySpUfFrEZ.jpg","width":1192,"height":1754,"iso_639_1":"fr","vote_average":3.334,"vote_count":1},{"file_path":"/mjWjajCGUPBSVxPSKhlwQvPBAmh.jpg","width":2000,"height":3000,"iso_639_1":"en","vote_average":3.334,"vote_count":1},{"file_path":"/8zKsmWch2Kfnt7RiffxQTgOuyYZ.jpg","width":1000,"height":1500,"iso_639_1":"