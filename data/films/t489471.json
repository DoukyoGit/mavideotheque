{"id":"t489471","key":"the dawn wall|2018","csv":{"title":"The Dawn Wall","year":2018,"directors":["Peter Mortimer Josh Lowell"],"rating":7,"watchedDate":"2019-05-20"},"status":"ok","tmdb":{"tmdbId":489471,"imdbId":"tt7286916","wikidataId":"Q56604528","title":"The Dawn Wall","originalTitle":"The Dawn Wall","altTitles":["ドーン・ウォール"],"tagline":"","overview":"Le film incontournable sur l'ascension qui a fait la une des journaux et enflammé l'imagination du monde entier. Tommy Caldwell et Kevin Jorgeson gravissent la paroi la plus difficile de tous les temps : une ascension de 19 jours du Dawn Wall, sur la face verticale d'El Capitan, haute de 900 mètres, dans le parc national de Yosemite. Le film va au-delà de l'ascension, plongeant dans l'histoire des grimpeurs et dressant un portrait intime des expériences de vie difficiles de Caldwell, qui ont abouti à sa détermination à accomplir cette ascension impossible. The Dawn Wall est un film touchant et inspirant qui célèbre la persévérance, la camaraderie et l'esprit universel de rêver grand et de ne jamais abandonner.","overviewLang":"fr","releaseDate":"2017-11-01","runtime":84,"status":"Released","genres":["Documentaire","Aventure"],"genreIds":[99,12],"countries":["Austria","United States of America"],"originCountry":["US"],"languages":["English"],"originalLanguage":"en","directors":["Peter Mortimer","Josh Lowell"],"directorIds":[68094,68093],"writers":[],"composers":[],"cinematographers":["Brett Lowell"],"editors":["Josh Lowell"],"producers":["Josh Lowell","Philipp Manderla","Peter Mortimer"],"cast":[{"id":107798,"name":"Tommy Caldwell","character":"Self","profilePath":"/jEGsQatwOpN3Cy24y8pBZI4bctS.jpg"},{"id":3988922,"name":"John Branch","character":"Self","profilePath":null},{"id":107801,"name":"Kevin Jorgeson","character":"Self","profilePath":"/wKTLnifPvTyB0RSZXJwlWpL7Nme.jpg"},{"id":6420213,"name":"Mike Caldwell","character":"Self – Tommy's Father","profilePath":null},{"id":6420214,"name":"Terry Caldwell","character":"Self – Tommy's Mother","profilePath":null},{"id":6420215,"name":"Kelly Cordes","character":"Self – Tommy's Friend","profilePath":null}],"companies":["Sender Films","Red Bull Media House"],"collection":null,"keywords":["based on true story","climbing","yosemite","rock climbing","el capitan"],"certificationFR":null,"certificationUS":"NR","budget":null,"revenue":null,"popularity":2.0147,"voteAverage":8.023,"voteCount":377,"adult":false,"posterPath":"/bZQCNGb1II5eWASBhEgJBGxOPUM.jpg","backdropPath":"/ipXrm6SEjfNkD8FKfj9VLUE9fUU.jpg","homepage":"https://www.mntnfilm.com/en/film/the-dawn-wall-2018","social":{"facebook":null,"instagram":null,"twitter":null}},"extra":{"credits":{"cast":[{"id":107798,"name":"Tommy Caldwell","original_name":"Tommy Caldwell","character":"Self","order":0,"gender":2,"known_for_department":"Acting","profile_path":"/jEGsQatwOpN3Cy24y8pBZI4bctS.jpg"},{"id":3988922,"name":"John Branch","original_name":"John Branch","character":"Self","order":1,"gender":0,"known_for_department":"Acting","profile_path":null},{"id":107801,"name":"Kevin Jorgeson","original_name":"Kevin Jorgeson","character":"Self","order":2,"gender":2,"known_for_department":"Acting","profile_path":"/wKTLnifPvTyB0RSZXJwlWpL7Nme.jpg"},{"id":6420213,"name":"Mike Caldwell","original_name":"Mike Caldwell","character":"Self – Tommy's Father","order":3,"gender":0,"known_for_department":"Acting","profile_path":null},{"id":6420214,"name":"Terry Caldwell","original_name":"Terry Caldwell","character":"Self – Tommy's Mother","order":4,"gender":0,"known_for_department":"Acting","profile_path":null},{"id":6420215,"name":"Kelly Cordes","original_name":"Kelly Cordes","character":"Self – Tommy's Friend","order":5,"gender":0,"known_for_department":"Acting","profile_path":null}],"crew":[{"id":1641162,"name":"Eliott Taylor","original_name":"Eliott Taylor","job":"Supervising Sound Editor","department":"Sound","gender":2,"profile_path":"/3RbDyL42fRLBiJd8c6H9LjNDGGZ.jpg"},{"id":68094,"name":"Peter Mortimer"