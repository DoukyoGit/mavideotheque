{"id":"t1242372","key":"cong 21 shi ji an quan che li|2024","csv":{"title":"Cong 21 Shi Ji an Quan Che Li","year":2024,"directors":["Yang Li"],"rating":8,"watchedDate":"2026-06-28"},"status":"ok","tmdb":{"tmdbId":1242372,"imdbId":"tt7171442","wikidataId":"Q126942870","title":"Escape from the 21st Century","originalTitle":"从21世纪安全撤离","altTitles":["从21世纪安全撤离","Cong 21 shiji anquan cheli","Escape from the 21st Century","Escapando del siglo XXI","Evacuate from the 21st Century"],"tagline":"","overview":"En 1999, après une bagarre, trois adolescents se retrouvent accidentellement exposés à une mystérieuse substance. Ils découvrent alors qu’un simple éternuement suffit à les faire voyager dans le temps.  Propulsés vingt ans plus tard, ils se retrouvent chargés d’une mission capitale : sauver le monde.","overviewLang":"fr","releaseDate":"2024-07-18","runtime":98,"status":"Released","genres":["Science-Fiction","Comédie","Action"],"genreIds":[878,35,28],"countries":["China"],"originCountry":["CN"],"languages":["普通话"],"originalLanguage":"zh","directors":["Li Yang"],"directorIds":[145614],"writers":["Li Yang"],"composers":["胡小鸥"],"cinematographers":["马舒翔"],"editors":["Huang Shang"],"producers":["An Xiaofen","Hu Lizhou"],"cast":[{"id":1675905,"name":"张若昀","character":"Wang Zha","profilePath":"/dnNTcRc58ikoJ0JihisgXYTwr75.jpg"},{"id":1815238,"name":"Zhong Chuxi","character":"Liu Lianzhi","profilePath":"/kdu1YCIasTJT4AiWUNu7SnJvk7q.jpg"},{"id":554932,"name":"宋洋","character":"Wang Chengyong","profilePath":"/eVSUyv9a2ZiPUTrCV88aqADNmT0.jpg"},{"id":1381455,"name":"吴晓亮","character":"Han Guang","profilePath":"/5p8OrMUsXN8d9svs2EJMSm5Mweb.jpg"},{"id":2044184,"name":"Zhu Yanmanzi","character":"Yang Yi","profilePath":"/dObU6l2DnIB9ZToSP2r08CDsQEq.jpg"},{"id":1602554,"name":"李晨浩","character":"Bubble / Paopao","profilePath":"/mppExpFo272vUpw2OlbCWuKaPCu.jpg"},{"id":2389969,"name":"温峥嵘","character":"San","profilePath":"/q9gdTw1WFKuK3GPko9cE4T9umQu.jpg"},{"id":134057,"name":"石凉","character":