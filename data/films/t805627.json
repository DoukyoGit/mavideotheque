{"id":"t805627","key":"dorosute no hate de bokura|2020","csv":{"title":"Dorosute no hate de bokura","year":2020,"directors":["Junta Yamaguchi"],"rating":7,"watchedDate":"2025-10-26"},"status":"ok","tmdb":{"tmdbId":805627,"imdbId":"tt14500584","wikidataId":"Q97167716","title":"Deux minutes plus tard","originalTitle":"ドロステのはてで僕ら","altTitles":["Droste no hate de bokura","Beyond the Infinite 2 Minutes","Más allá de los dos minutos infinitos","Neskončni dve minuti","Beyond the Infinite Two Minutes","ドロステのはてで僕ら：2020","A Dois Minutos do Infinito"],"tagline":"","overview":"Un homme propriétaire d'un café découvre que la télévision dans son établissement s'est mise à montrer des images du futur, mais seulement de deux minutes dans le futur.","overviewLang":"fr","releaseDate":"2020-06-05","runtime":70,"status":"Released","genres":["Comédie","Science-Fiction"],"genreIds":[35,878],"countries":["Japan"],"originCountry":["JP"],"languages":["日本語"],"originalLanguage":"ja","directors":["山口淳太"],"directorIds":[3008307],"writers":["上田誠"],"composers":[],"cinematographers":["山口淳太"],"editors":["山口淳太"],"producers":["Kazuchika Yoshida","Takahiro Otsuki"],"cast":[{"id":1998971,"name":"土佐和成","character":"Kato","profilePath":"/pjmEpy5LN9DIX6Z580Ol59kUc0e.jpg"},{"id":1115687,"name":"朝倉あき","character":"Megumi","profilePath":"/65ZiHTem1HFNx4aHBcqQPdRRsPn.jpg"},{"id":2804365,"name":"藤谷理子","character":"Aya","profilePath":"/ujpigApXRsEp21hULUagkvsKWyY.jpg"},{"id":2523975,"name":"石田剛太","character":"Komiya","profilePath":"/l45dUW3p92TyisWlqRs2rYwRS6I.jpg"},{"id":1301880,"name":"諏訪雅","character":"Tanabe","profilePath":"/2AOA8aQVIONIoZZm64FM43Twdk6.jpg"},{"id":1552673,"name":"酒井善史","character":"Ozawa","profilePath":null},{"id":1777999,"name":"中川晴樹","character":"Narita","profilePath":null},{"id":3009495,"name":"角田貴志","character":"Furuya","profilePath":null},{"id":124958,"name":"永野宗典","character":"Kinjo","profilePath":"/4SYOW0lZTd3cNvNLmct4TfQSE88.jpg"},{"id":124964,"name":"本多力","character":"Ishizuka","pr