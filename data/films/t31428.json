ment":"Production","gender":2,"profile_path":null},{"id":1339233,"name":"Karl Silvera","original_name":"Karl Silvera","job":"Makeup Artist","department":"Costume & Make-Up","gender":2,"profile_path":null}]},"alternativeTitles":[{"iso_3166_1":"US","title":"High Rise","type":"working title"},{"iso_3166_1":"AZ","title":"Kimsə Məni İzləyir","type":""},{"iso_3166_1":"CN","title":"怪客逞凶","type":""},{"iso_3166_1":"CN","title":"有人看我","type":""}],"externalIds":{"imdb_id":"tt0078295","wikidata_id":"Q1171655","facebook_id":null,"instagram_id":null,"twitter_id":null},"keywords":[{"id":6844,"name":"stalker"},{"id":10333,"name":"stalking"}],"releaseDates":[{"iso_3166_1":"US","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"NBC","release_date":"1978-11-29T00:00:00.000Z","type":6}]}],"translations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"","overview":"A young woman moves to a high-rise apartment building and soon begins to be tormented by an unknown stalker who seems to know her every move.","tagline":"All those windows… and he’s behind one of them!"},{"iso_639_1":"de","iso_3166_1":"DE","name":"Deutsch","english_name":"German","title":"Das unsichtbare Auge","overview":"Eine junge Frau, die neu in ein Hochhaus eingezogen ist, wird durch anonyme Anrufe und seltsame Geschenke belästigt. Eines Abends findet sie sogar einen von ihr unterzeichneten Abschiedsbrief vor. Schnell stellt sie fest, dass anscheinend jemand vom gegenüberliegenden Hochhaus jeden ihrer Schritte beobachtet.","tagline":""},{"iso_639_1":"it","iso_3166_1":"IT","name":"Italiano","english_name":"Italian","title":"Pericolo in agguato","overview":"Lei è una donna in carriera che ad un certo punto viene ossessionata da qualcuno che la segue. A nulla vale rivolgersi alla polizia: dovrà affrontare da sola l'insistente pedinatore.","tagline":""},{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"Meurtre au 43e étage","overview":"Fraîchement débarquée à Los Angeles où elle trouve un poste dans une station de télévision locale, une jeune femme célibataire emménage au 43e étage d'une résidence huppée. Elle reçoit bientôt d'étranges cadeaux ainsi que des appels téléphoniques de plus en plus inquiétants. Persuadée qu'un maniaque lui en veut, elle contacte en vain la police avant de décider de poursuivre elle-même cet homme mystérieux qui la harcèle.","tagline":""},{"iso_639_1":"es","iso_3166_1":"ES","name":"Español","english_name":"Spanish","title":"¡Alguien me está espiando!","overview":"Leigh Michaels es la flamante directora de noticas de una cadena de televisión neoyorquina que acepta el traslado a Los Ángeles para poner tierra de por medio en un asunto del corazón, pero ni su privilegiada posición ni sus encantos hacen mella en la policía cuando denuncia el acoso al que está siendo sometida. Lee recibe llamadas telefónicas de un misterioso individuo que vive en el apartamento frente al de ella.","tagline":""},{"iso_639_1":"hu","iso_3166_1":"HU","name":"Magyar","english_name":"Hungarian","title":"Valaki figyel","overview":"A horror műfaj nagymesterének tartják sokan John „Thrillmaster” Carpentert. Hitchcock méltó utódjává avatta őt a nézők szemében első televíziós munkája. Több mint húsz év eltelt azóta és sötét filmje még mindig odaszögezi rajongóit a képernyőhöz. A történet egy rendezőnőről, Leigh-ről szól, aki Los Angelesbe költözik, miután New Yorkban otthagyta szeretőjét és munkáját. Gyorsan sikerül munkát találnia és beköltözik egy pazar apartmanba. Úgy érzi, végre révbe jutott… Az utca másik oldaláról nap mint nap egy pszichopata kémleli őt teleszkópjával. Megszállottan ajándékokat küldözget neki és telefonon zaklatja a nőt. Leigh értesíti a rendőrséget többször is, de nem veszik komolyan félelmeit. Nincs választása: egyedül kell megszabadulnia beteges rajongójától…","tagline":"Az elveszett John Carpenter klasszikus"},{"iso_639_1":"ru","iso_3166_1":"RU","name":"Pусский","english_name":"Russian","title":"Кто-то наблюдает за мной!","overview":"Молодая и очень активная женщина Ли Майклз, по профессии режиссер телепередач, переезжает в Лос-Анджелес, где покупает квартиру в многоэтажном доме и устраивается по специальности на местном телевидении. Она медленно сходила с ума, пока человек из многоэтажки напротив внимательно следил за ней из своего окна. Полиция не воспринимала ее жалобы и просьбы о помощи всерьез. Тогда она решила отправиться в дом напротив разобраться самостоятельно.","tagline":""},{"iso_639_1":"es","iso_3166_1":"MX","name":"Español","english_name":"Spanish","title":"¡Alguien me vigila!","overview":"","tagline":""},{"iso_639_1":"pl","iso_3166_1":"PL","name":"Polski","english_name":"Polish","title":"Ktoś mnie obserwuje","overview":"Po przeprowadzce do nowego mieszkania dziewczyna czuje, że jest obserwowana.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"怪客逞凶","overview":"B级片恐怖大师约翰·卡朋特导演作品。一名女子遭到对面高层建筑的一名男子的偷窥，精神已经接近崩溃边缘，她开始求助警察并决定自己追捕这名男子的行踪。","tagline":"那么多扇窗户……他就在其中一扇后面！"},{"iso_639_1":"sv","iso_3166_1":"SE","name":"svenska","english_name":"Swedish","title":"","overview":"En ung kvinna i karriären utsätts för långsam terror av en man i ett närliggande höghus. När hon inte får något skydd av polisen tvingas hon ta saken i egna händer.","tagline":""},{"iso_639_1":"pt","iso_3166_1":"BR","name":"Português","english_name":"Portuguese","title":"Alguém Me Vigia","overview":"Ao receber uma ligação de um perseguidor, Elizabeth, em desespero, se joga da janela do apartamento 4320 e comete suicídio. Algum tempo depois, Leigh Michaels, em fuga de Nova York devido a um amor não correspondido, compra o mesmo apartamento. Começa, pouco a pouco, uma perseguição psicológica que leva Leigh à beira da loucura.","tagline":"Todas essas janelas... e ele está atrás de uma delas!"},{"iso_639_1":"fi","iso_3166_1":"FI","name":"suomi","english_name":"Finnish","title":"Vainoavat silmät","overview":"Televisioon tehty Carpenterin tribuutti Hitchcockille on varsin pätevä jännäri naisesta ja stalkkerista.","tagline":""},{"iso_639_1":"ko","iso_3166_1":"KR","name":"한국어/조선말","english_name":"Korean","title":"욕망의 불꽃","overview":"미모의 젊은 여인 리 미첼(로렌 허튼 분)은 LA의 호화판 고층 아파트에서 평화롭게 살아간다.  그런데 누군가가 고성능 망원경을 통해 일거수 일투족을 엿보고 있다는 사실을 안 순간부터 그녀의 생활은 악몽의 나날이 된다.  괴전화가 걸려오고 이상한 선물과 편지 누드 사진이 연이어 배달되어 오자  견디다 못한 그녀는 애인 폴(데이비드 비르니 분)과 친구 소피(아드리엔 바르보 분)의 도움을 받아 직접 망원경의 주인공을 찾아나선다. 그러나 친구 소피가 살해를 당하게 되는데....","tagline":""},{"iso_639_1":"tr","iso_3166_1":"TR","name":"Türkçe","english_name":"Turkish","title":"Biri Beni İzliyor","overview":"","tagline":""},{"iso_639_1":"nl","iso_3166_1":"NL","name":"Nederlands","english_name":"Dutch","title":"","overview":"Een jonge vrouw verhuist naar een flatgebouw en wordt al snel gekweld door een onbekende stalker die haar elke beweging lijkt te kennen.","tagline":""},{"iso_639_1":"da","iso_3166_1":"DK","name":"Dansk","english_name":"Danish","title":"","overview":"Leigh Michaels flytter til L.A. for at arbejde for en TV station, og hun får en lejlighed i et moderne, high-tech højhus. Der går ikke lang tid, før hun begynder at modtage mystiske opkald. Der dukker også mærkelige gaver op i tide og utide. En eller anden mystisk person betragter i hemmelighed Leigh, og hun føler sig mere og mere truet af den uønskede beundrer.","tagline":""},{"iso_639_1":"pt","iso_3166_1":"PT","name":"Português","english_name":"Portuguese","title":"Alguém anda a espiar-me","overview":"","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"怪客逞兇","overview":"B 級片恐怖大師約翰·卡朋特導演作品。一名女子遭到對面高層建築的一名男子的偷窺，精神已經接近崩潰邊緣，她開始求助警察並決定自己追捕這名男子的行蹤。","tagline":""},{"iso_639_1":"ar","iso_3166_1":"SA","name":"العربية","english_name":"Arabic","title":"","overview":"تنتقل شابة إلى شقة في مبنى شاهق، فيبدأ مطارد مجهول في تعذيبها، ويبدو أنه يعرف كل تحركاتها.","tagline":""}],"videos":[{"key":"QCG575qm5BY","site":"YouTube","type":"Featurette","name":"Actres