{"id":"t39915","key":"ching se|1993","csv":{"title":"Ching se","year":1993,"directors":["Tsui Hark"],"rating":8,"watchedDate":"2026-08-01"},"status":"ok","tmdb":{"tmdbId":39915,"imdbId":"tt0106559","wikidataId":"Q1133710","title":"Green Snake","originalTitle":"青蛇","altTitles":["Blue Snake","White Snake, Green Snake","Ching se","นางพญางูขาว ขอเพียงรักอยู่ แม้คู่กันไม่ได้","青蛇","Green Snake","청사","Yaşıl İlan"],"tagline":"","overview":"Cette histoire est inspirée de la Légende du serpent blanc. Il y a deux serpents inséparables : l'un a 1000 ans, l'autre 500 ans ; l'un est blanc, l'autre vert. Un jour, ils trouvent le chapelet du bouddha et se transforment en deux jolies filles. Elles apprennent toutes les choses humaines mais n'arrivent pas à comprendre les sentiments. Au fil de l'histoire, les sentiments finissent par arriver naturellement.","overviewLang":"fr","releaseDate":"1993-11-04","runtime":90,"status":"Released","genres":["Action","Fantastique","Romance"],"genreIds":[28,14,10749],"countries":["Hong Kong"],"originCountry":["HK"],"languages":["广州话 / 廣州話"],"originalLanguage":"cn","directors":["Tsui Hark"],"directorIds":[26760],"writers":["李碧華","Tsui Hark"],"composers":["雷頌德","黃霑"],"cinematographers":["高照林"],"editors":["亞積"],"producers":["Tsui Hark","Ng See-Yuen"],"cast":[{"id":1338,"name":"Maggie Cheung","character":"Green Snake","profilePath":"/hre6xmoDbh67YN7wR5nhUazPTlb.jpg"},{"id":68557,"name":"王祖賢","character":"White Snake","profilePath":"/4QEPMOcjlbcZVqFiFN9k5pAOHge.jpg"},{"id":82400,"name":"赵文卓","character":"Fat Hoi","profilePath":"/hylhhRtmXQLxOmkC2K7zsjCBFEA.jpg"},{"id":1136775,"name":"吳興國","character":"Hui Sin","profilePath":"/u5IK5de0GkwYwyYeub1K3IXCDqx.jpg"},{"id":64989,"name":"马精武","character":"Blind Taoist","profilePath":"/ic3enY3tw0bfctgYRkrYdTL84mR.jpg"},{"id":65974,"name":"Lau Shun","character":"Old Monk","profilePath":"/sNnEnje7gqpOQZR3NWIodvh0ti5.jpg"},{"id":121394,"name":"Tien Feng","character":"Spider Spirit","profilePath":"/qoPyMy8NCZZ6aYMD