artment":"Production","gender":2,"profile_path":"/xfJTgLD5eJO5qdxYD4BblOGmVBz.jpg"},{"id":5324302,"name":"小澤 浩幸","original_name":"小澤 浩幸","job":"Director of Photography","department":"Camera","gender":2,"profile_path":null},{"id":1335001,"name":"Kensuke Sonomura","original_name":"園村健介","job":"Stunts","department":"Crew","gender":2,"profile_path":"/zx6nfs6g9Bg7XVbJq3haoRNneCX.jpg"}]},"alternativeTitles":[{"iso_3166_1":"CA","title":"One-Percent Warrior","type":""},{"iso_3166_1":"AU","title":"One Percenter","type":""}],"externalIds":{"imdb_id":"tt15714400","wikidata_id":null,"facebook_id":null,"instagram_id":null,"twitter_id":null},"keywords":[{"id":779,"name":"martial arts"}],"releaseDates":[{"iso_3166_1":"BE","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"BIFFF","release_date":"2023-04-12T00:00:00.000Z","type":1}]},{"iso_3166_1":"GB","release_dates":[{"certification":"15","descriptors":[],"iso_639_1":"","note":"","release_date":"2024-03-11T00:00:00.000Z","type":4},{"certification":"15","descriptors":[],"iso_639_1":"","note":"Blu-ray","release_date":"2024-03-11T00:00:00.000Z","type":5}]},{"iso_3166_1":"KR","release_dates":[{"certification":"12","descriptors":[],"iso_639_1":"","note":"Bucheon International Fantastic Film Festival","release_date":"2023-07-01T00:00:00.000Z","type":1}]},{"iso_3166_1":"US","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Fantastic Fest","release_date":"2023-09-23T00:00:00.000Z","type":1}]}],"translations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"One-Percenter","overview":"After his devastatingly fast, samurai-style combat approach sets filmmakers against him, a legendary action star films his own movie—on turf claimed by feuding yakuza gangs, including Japan’s deadliest martial arts assassin.","tagline":""},{"iso_639_1":"ko","iso_3166_1":"KR","name":"한국어/조선말","english_name":"Korean","title":"원 퍼센터","overview":"영화 배우 타쿠마 토시로는 진정한 액션 영화를 만들겠다는 목표가 있지만, 그의 사무라이적 접근은 CG와 속도감으로 점철된 영화계의 관습에 녹아들지 못한다. 이상적인 액션 영화를 만들고자 한 세트장에 도착한 순간, 숨겨진 마약을 찾는 야쿠자가 들이닥치고 토시로는 실제 폭력, 그리고 진정한 액션에 휘말리게 된다. 과연 이 돌발상황은 ‘진정한 액션’을 다음 단계로 끌어올릴 절호의 찬스인가?","tagline":""},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"孤高","overview":"在他那种迅猛无比、如武士般的战斗方式让影人对他产生反感后，这位传奇动作明星在两个敌对的黑帮（包括日本最致命的武术刺客）争夺的地盘上拍摄自己的电影。\r 《孤高》：1%er（ワンパーセンター），那是能够在其道路上达到极致的 1%的被选中的存在。曾经风靡一时的孤高的动作演员·匠马敏郎，由于执着于实践真实的动作，在电影界失去了立足之地，过着平淡无奇的日子。有一天，他决定和弟子阿基拉一起拍摄自己的动作电影，前往变成废墟的无人岛，然而岛上隐藏着雇佣兵集团们所觊觎的某个秘密… 在封闭的岛上被卷入事件的敏郎，被将截拳道练至极致的最强武术家·黄岛盯上了性命。掌握了最新战斗术的“杀不死”的动作演员，在极限状态下觉醒了沉睡的自身力量之时，被选中的男人们的战斗开始了。","tagline":""},{"iso_639_1":"ja","iso_3166_1":"JP","name":"日本語","english_name":"Japanese","title":"1%er ワンパーセンター","overview":"アクション俳優の匠馬敏郎は一世を風靡したが、道を突き詰めるうちに映画界に居場所をなくしてしまう。冴えない日々を過ごす敏郎は、アクション映画を撮りに弟子のアキラと無人島を訪れる。しかし島には傭兵集団が狙う秘密が眠っており、敏郎は命を狙われる。","tagline":"世界が認めた リアルアクションムービー誕生"},{"iso_639_1":"sl","iso_3166_1":"SI","name":"Slovenščina","english_name":"Slovenian","title":"","overview":"Zvezdnik akcijskih filmov Toshiro Takuma je popolnoma posvečen svojemu poklicu, za ta namen je celo razvil vrsto unikatnih tehnik. Toda razočaran nad modernimi filmskimi prijemi se odloči posneti svoj lasten sanjski film. Ko pa snemanje prekineta neusmiljeni tolpi jakuz, med katerimi je tudi najsmrtonosnejši morilec japonskih borilnih veščin, bo pokazal, kaj zares zmore.","tagline":""},{"iso_639_1":"nl","iso_3166_1":"NL","name":"Nederlands","english_name":"Dutch","title":"","overview":"Actiefilmster Toshiro Takuma is volledig toegewijd aan zijn vak en heeft hiervoor zelfs een reeks unieke technieken ontwikkeld. Maar gedesillusioneerd door de moderne filmtechnieken besluit hij zijn eigen droomfilm te maken. Maar wanneer de opnames worden onderbroken door meedogenloze yakuza-bendes, waaronder de dodelijkste moordenaar in de Japanse vechtkunst, zal hij laten zien wat hij werkelijk kan.","tagline":""},{"iso_639_1":"ro","iso_3166_1":"RO","name":"Română","english_name":"Romanian","title":"One Percenter","overview":"One Percenter (1%er): One-Percent Warrior (2023) este un film de acțiune japonez regizat de Yudai Yamaguchi, cu Tak Sakaguchi în rol principal. Povestea se desfășoară într-o locație abandonată, unde o vedetă de acțiune încearcă să filmeze un film pe un teritoriu revendicat de două clanuri yakuza rivale. Înfruntându-se cu un asasin expert în arte marțiale și cu zeci de yakuza, eroul folosește stilul său unic de luptă samurai pentru a face față provocărilor. Coregrafia spectaculoasă a luptelor este realizată de Kensuke Sonomura, recunoscut pentru lucrările sale în filme precum Hydra și Baby Assassins. Filmul este caracterizat printr-o combinație de acțiune intensă și stil vizual distinct.","tagline":""},{"iso_639_1":"ru","iso_3166_1":"RU","name":"Pусский","english_name":"Russian","title":"Один процент","overview":"Выходящий в тираж актёр боевиков, настоящий мастер - единоборств. Вот уже десять лет прошло с момента выхода его последнего хита, теперь перебивается исключительно второстепенными ролями в самурайских фильмах, где персонажи \"летают\" по воздуху и сражаются понарошку. Ему это очень не нравится, он считает, что герои боевиков должны исполнять на экране реалистичные бои и сами должны быть подготовлены должным образом и даже уметь убить человека голыми руками в реальном бою. Он решает воскресить свою карьеру и снять самый реалистичный боевик в плане боевых рукопашных сцен. Найдя продюсера, который соглашается финансировать его фильм, он приезжает осмотреть локацию для съемок, которая представляет из себя заброшенную фабрику, расположенную на острове...","tagline":""},{"iso_639_1":"pl","iso_3166_1":"PL","name":"Polski","english_name":"Polish","title":"","overview":"Po tym, jak jego zabójczo szybkie, samurajskie podejście do walki nastawiło filmowców przeciwko niemu, legendarny gwiazdor kina akcji kręcił własny film — na terenie, który przypadł w udziale walczącym gangom yakuzy, w tym najniebezpieczniejszemu zabójcy sztuk walki w Japonii.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"孤高","overview":"","tagline":""},{"iso_639_1":"vi","iso_3166_1":"VN","name":"Tiếng Việt","english_name":"Vietnamese","title":"Chiến Binh","overview":"Sau khi lối đánh võ thuật nhanh như chớp theo phong cách samurai của anh khiến các nhà làm phim quay lưng lại với mình, một ngôi sao hành động huyền thoại đã tự mình thực hiện bộ phim – trên lãnh địa tranh giành của các băng đảng yakuza, bao gồm cả sát thủ võ thuật nguy hiểm nhất Nhật Bản.","tagline":""},{"iso_639_1":"es","iso_3166_1":"MX","name":"Español","english_name":"Spanish","title":"","overview":"Dos despiadadas bandas yakuza interrumpen el rodaje de una película de acción en una fábrica abandonada. La estrella de acción no está muy contenta. ¿Cien yakuzas contra uno? Pfff, demasiado fácil.","tagline":""}],"videos":[{"key":"HV8ys0J6djs","site":"YouTube","type":"Trailer","name":"Official Trailer","iso_639_1":"en","official":true,"published_at":"2024-02-01T19:52:52.000Z","size":1080}],"images":{"posters":[{"file_path":"/4IPFHdnSgWof5Vu62L8okZG1tt2.jpg","width":2000,"height":3000,"iso_639_1":"en","vote_average":2.278,"vote_count":3},{"file_path":"/1FhhWzyMJB1DaegiDFrx1q7g1Ap.jpg","width":1000,"height":1414,"iso_639_1":"en","vote_average":1.222,"vote_count":3},{"file_path":"/cXe1jgJosMqjKHhgJrAphujrW2m.jpg","width":2000,"height":3000,"iso_639_1":"en","vote_average":1.222,"vote_count":3}],"backdrops":[{"file_path":"/tdaeJWBrptYg1Ys6eEU6Y1HnUjA.jpg","width":3840,"height":2160,"iso_639_1":null,"vote_average":3.334,"vote_count":2},{"file_path":"/8zogfFUUhoHwm0kNwCSxEhHqnPY.jpg","width":3840,"height":2160,"iso_639_1":null,"vote_average":2.278,"vote_count":3},{"file_path":"/j4OIacra5fahpSUayUOTYmcn6xF.jpg","width":3840,"height":2160,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/rSIHYK3c41g1tiLDVoi5yp1R0TL.jpg","width":3840,"height":2160,"iso_639_1":"en","vote_average":0,"vote_count":