6_1":"US","title":"Eye for an Eye 2: Blind Vengeance","type":""},{"iso_3166_1":"RU","title":"Слепой меч 2","type":""}],"externalIds":{"imdb_id":"tt30972810","wikidata_id":"Q135679120","facebook_id":null,"instagram_id":null,"twitter_id":null},"keywords":[],"releaseDates":[{"iso_3166_1":"CN","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"zh","note":"","release_date":"2024-02-10T00:00:00.000Z","type":4}]},{"iso_3166_1":"ES","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Asian Summer Film Festival","release_date":"2024-07-21T00:00:00.000Z","type":1}]},{"iso_3166_1":"FR","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"L'étrange festival","release_date":"2024-09-11T00:00:00.000Z","type":1}]},{"iso_3166_1":"KR","release_dates":[{"certification":"19","descriptors":[],"iso_639_1":"","note":"2024-VF01466","release_date":"2024-11-15T00:00:00.000Z","type":4}]},{"iso_3166_1":"RU","release_dates":[{"certification":"18+","descriptors":[],"iso_639_1":"ru","note":"«СБ Фильм»","release_date":"2025-06-19T00:00:00.000Z","type":1}]},{"iso_3166_1":"US","release_dates":[{"certification":"NR","descriptors":[],"iso_639_1":"","note":"","release_date":"2024-12-13T00:00:00.000Z","type":4}]}],"translations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"Eye for an Eye 2","overview":"The blind swordsman, skilled in martial arts, named Cheng Xiazi (Xie Miao), accidentally saves Zhang Xiaoyu (Yang Enyou), who has suffered from the destruction of his family. Under the persuasion of the orphan Xiaoyu, Cheng reluctantly keeps him by his side and teaches him skills. Xiaoyu also waits for the opportunity to seek revenge.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"目中无人2","overview":"武艺高强的盲眼捉刀人成瞎子偶然救下惨遭灭门的孤女张小渔。本想继续独来独往的他，却经不住小渔的软磨硬泡，只得将她留在身边，并开始传授她防身的本领。在一路相处中，孤僻冷漠的成瞎子逐渐被小渔的执着与童真打动，而始终没有放下灭门之仇的小渔，也在等待着属于自己的复仇时机……","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"目中無人2：以眼還眼","overview":"武艺高强的盲眼捉刀人成瞎子（谢苗 饰）偶然救下了惨遭灭门的张小渔（杨恩又 饰）。在孤儿小渔的软磨硬泡下，成瞎子无奈将其留在身边并教其本领，小渔也等待着时机准备复仇……","tagline":""},{"iso_639_1":"zh","iso_3166_1":"TW","name":"普通话","english_name":"Mandarin","title":"目中無人2","overview":"武藝高強的盲眼捉刀人成瞎子（謝苗 飾）偶然救下了慘遭滅門的張小漁（楊恩又 飾）。在孤兒小漁的軟磨硬泡下，成瞎子無奈將其留在身邊並教其本領，小漁也等待著時機準備複仇……","tagline":""},{"iso_639_1":"ko","iso_3166_1":"KR","name":"한국어/조선말","english_name":"Korean","title":"목중무인 2","overview":"현상 수배범을 잡으며 사는 맹인 검객 도위. 그의 삶에 고아 장소어가 느닷없이 나타난다. 복수를 도와 달라는 장소어의 끈질긴 부탁에 어쩔 수 없이 곁에 두고 무예를 가르치고, 도위의 닫혀 있던 마음도 서서히 열리게 되는데...","tagline":"운명에 눈을 잃고 복수로 날을 세우다"},{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"Eye for an Eye 2","overview":"Cheng Xia Zi, un épéiste aveugle doué pour les arts martiaux, sauve accidentellement Zhang Xiao Yu, qui a souffert de la destruction de sa famille. Sous la persuasion de l'orphelin Xiao Yu, Cheng Xia Zi le garde à contrecœur à ses côtés et lui enseigne des techniques. Xiao Yu attend également l'occasion de se venger.","tagline":""},{"iso_639_1":"vi","iso_3166_1":"VN","name":"Tiếng Việt","english_name":"Vietnamese","title":"Mục Trung Vô Nhân 2: Dùng Mắt Trả Mắt","overview":"Bộ phim rạp này là phần tiếp theo của bộ phim trực tuyến năm 2022 mang tên \"Mục Trung Vô Nhân\" kể về Thành Hạt Tử ( Tạ Miêu thủ vai), một người mù có võ nghệ cao cường. Thành Hạt Tử tình cờ cứu sống Trương Tiểu Ngư ( Dương n Hữu thủ vai) có gia đình bị sát hại . Dưới sự thuyết phục của Tiểu Ngư, Thành Hạt Tử không thể từ chối cậu nên đã đồng ý giữ cậu lại và dạy cho cậu võ thuật. Tiểu Ngư cũng đang chờ đợi thời cơ để bắt đầu hành trình trả thù.","tagline":""},{"iso_639_1":"pt","iso_3166_1":"BR","name":"Português","english_name":"Portuguese","title":"Eye for an Eye 2","overview":"O exímio espadachim conhecido como Cego Cheng acidentalmente salva Zhang Xiaoyu, que sofreu um trágico massacre familiar. Cedendo aos pedidos persistentes da órfã Xiaoyu, Cheng Yazi relutantemente a mantém ao seu lado e transmite suas habilidades a ela. Xiaoyu, por sua vez, aguarda o momento oportuno para se vingar.","tagline":""},{"iso_639_1":"bg","iso_3166_1":"BG","name":"български език","english_name":"Bulgarian","title":"Око за око 2","overview":"Слепият Cheng Xia Zi, майстор на меча с уникални умения в бойните изкуства, продължава да залавя бегълци престъпници в замяна на награда. В същото време Zhang Xiaoyu и семейството му спират в Yuzhou за нощувка на път за Chang'an, където са отишли да се срещнат с главата на семейство Li, за да потърсят справедливост за дъщеря си He Lan, която почина в ръцете на сина на, Li Jiulana. Същата нощ обаче той ги намира и извършва клане, при което оцелява само Zhang Xiao Yu. На следващата сутрин тя следва слепия Cheng Xia Zi, който е отишъл на следващата си мисия, и го моли да отмъсти на убиеца, на което той отказва. Но поддавайки се на настойчивите молби, той все пак неохотно я взема със себе си и започва да я учи на умения за бойни изкуства. Zhang Xiao Yu на свой ред чака подходящия момент, за да отмъсти на Li Jiulana за зверствата му…","tagline":""},{"iso_639_1":"ca","iso_3166_1":"ES","name":"Català","english_name":"Catalan","title":"Eye for an eye 2","overview":"Un espadatxí cec, expert en arts marcials, rescata una nena òrfena que acaba de perdre el seu germà. L'espadatxí acaba adoptant la nena i es converteix en el seu mestre, ensenyant-li les tècniques més letals mentre esperen el dia de la venjança.","tagline":""},{"iso_639_1":"nl","iso_3166_1":"NL","name":"Nederlands","english_name":"Dutch","title":"","overview":"Cheng Xia Zi, een blinde zwaardvechter die bedreven is in vechtsporten, redt per ongeluk Zhang Xiao Yu, die heeft geleden onder de vernietiging van zijn familie. Onder de overtuiging van de wees Xiao Yu houdt Cheng Xia Zi hem met tegenzin aan zijn zijde en leert hem technieken. Xiao Yu wacht ook op de kans om wraak te nemen.","tagline":""},{"iso_639_1":"ro","iso_3166_1":"RO","name":"Română","english_name":"Romanian","title":"Ochi pentru ochi 2","overview":"Spadasinul orb, priceput în artele marțiale, pe nume Cheng Xiazi (Xie Miao), îl salvează accidental pe Zhang Xiaoyu (Yang Enyou), care a suferit din cauza distrugerii familiei sale. Sub persuasiunea orfanului Xiaoyu, Cheng îl ține fără tragere de inimă lângă el și îi învață abilități. Xiaoyu așteaptă, de asemenea, ocazia de a se răzbuna.","tagline":""},{"iso_639_1":"th","iso_3166_1":"TH","name":"ภาษาไทย","english_name":"Thai","title":"ยอดกระบี่ไร้เทียมทาน 2","overview":"","tagline":""},{"iso_639_1":"cs","iso_3166_1":"CZ","name":"Český","english_name":"Czech","title":"Eye for an Eye 2","overview":"Slepý šermíř, zkušený v bojových uměních, jménem Cheng Xiazi (Xie Miao), náhodou zachrání Zhang Xiaoyu (Yang Enyou), který trpěl zničením své rodiny. Čeng si pod přesvědčením sirotka Siao-jüa neochotně ponechá po svém boku a učí ho dovednostem. Xiaoyu zároveň čeká na příležitost k pomstě.","tagline":""},{"iso_639_1":"ru","iso_3166_1":"RU","name":"Pусский","english_name":"Russian","title":"Слепой меч. Око за око","overview":"Слепой фехтовальщик неохотно становится наставником девочки-сироты, жаждущей отомстить за свою разрушенную семью, обучая её боевым искусствам.","tagline":""},{"iso_639_1":"de","iso_3166_1":"DE","name":"Deutsch","english_name":"German","title":"","overview":"Auf seinen Wanderungen passierte der sehlose Söldner Schwertkämpfer Cheng Xiazi (Xie Miao) nach dem Schlachten einer Familie ... und nahm seinen einzigen Überlebenden ein, das junge Mädchen Zhang Xiaoyu (Yang Enyou). Cheng gibt seinen unwahrscheinlichen neuen Gebühren nach, beginnt ihr Training in seinem tödlichen Fähigkeitsset zu geben - aber wird er ihren Wunsch nach Rache verwöhnen?","tagline":""},{"iso_639_1":"pl","iso_3166_1":"PL","name":"Polski","english_name":"Polish","title":"Oko za oko 2","overview":"Niewidomy łowca nagród, który przebojem zdobył całą Azję, powraca! Tym razem przypadkowo ratując życie dziecku, staje się opiekunem i nauczycielem sieroty marzącego o zemście na zabójcach swojej rodziny.","tagline":""}],"videos":[{"key":"FRD0KojW03E","site":"YouTube","type":"Trailer","name":"Official Trailer [Subtitled]","iso_639_1":"en","official":true,"published_at":"2025-03-05T22:44:07.000Z","size":1080},{"key":"TQUsUHULMMw","site":"YouTube","type":"Trailer","name":"【FILM】EYE FOR AN EYE 2 目中无人2：以眼还眼 TRAILER","iso_639_1":"en","official":false,"published_at":"2024-02-02T07:32:20.000Z","size":1080}],"images":{"posters":[{"file_path":"/lxGkinl8TwFdIUffEdTOw95lKL7.jpg","width":1008,"height":1512,"iso_639_1":"en","vote_average":2.278,"vote_count":3},{"file_path":"/cqycEDHYiKyRENGLaB2BmxE3XuW.jpg","width":500,"height":750,"iso_639_1":"en","vote_average":1.75,"vote_count":2},{"file_path":"/mkfznkTshGBp88SFQQAGsr3R62z.jpg","width":1000,"height":1500,"iso_639_1":"en","vote_average":1.75,"vote_count":2},{"file_path":"/aIv66EpmLRenB0ih8PSiwQEDgOp.jpg","width":1008,"height":1512,"iso_639_1":"en","vote_average":0.166,"vote_count":1},{"file_path":"/2CMNCbvODGiR1zmWcSp13IuKl9a.jpg","width":1000,"height":1500,"iso_639_1":null,"vote_average":0,"vote_count":0}],"backdrops":[{"file_path":"/bx6LoGl8L3hwgOCoD2H8JgIu7uC.jpg","width":1280,"height":720,"iso_639_1":null,"vote_average":3.334,"vote_count":1},{"file_path":"/pmffUNTCdLD4Q3EOiWreqVy6n6k.jpg","width":1280,"height":720,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/2tFmZBtUQGSdrSq5T7B18KbVWdy.jpg","width":1340,"height":754,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/pkwYCxRSWRcJLnlQyxgjKG9ByxL.jpg","width":1340,"height":754,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/hkGSFehJ4gvTurJm36QGdj6ua8Y.jpg","width":1340,"height":754,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/tZM1rj1UWSRf45U1l0RcAcRlrqK.jpg","width":1340,"height":754,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/cNGAtmglQQfHZpVtmV168ra8EpH.jpg","width":192