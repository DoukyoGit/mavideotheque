path":null},{"id":1705481,"name":"Ben Desmond","original_name":"Ben Desmond","job":"Script Supervisor","department":"Directing","gender":2,"profile_path":null},{"id":1625155,"name":"Levan Doran","original_name":"Levan Doran","job":"Stunt Coordinator","department":"Crew","gender":2,"profile_path":"/7MfCdxrM33N2CEvVEcReaEf4Mf1.jpg"},{"id":1625155,"name":"Levan Doran","original_name":"Levan Doran","job":"Fight Choreographer","department":"Crew","gender":2,"profile_path":"/7MfCdxrM33N2CEvVEcReaEf4Mf1.jpg"}]},"alternativeTitles":[],"externalIds":{"imdb_id":"tt6136778","wikidata_id":"Q104428371","facebook_id":null,"instagram_id":null,"twitter_id":null},"keywords":[{"id":325665,"name":"slasher horror"}],"releaseDates":[{"iso_3166_1":"DE","release_dates":[{"certification":"18","descriptors":[],"iso_639_1":"de","note":"","release_date":"2019-04-12T00:00:00.000Z","type":5}]},{"iso_3166_1":"GB","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"en","note":"Edinburgh International Film Festival","release_date":"2017-06-30T00:00:00.000Z","type":1}]}],"translations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"","overview":"Meet innocent Jim, terrified of girls, and on a reluctant quest to prove his manhood the night before he turns 30. He and his cocky friend Alex think they’ve hit the jackpot when they meet the beautiful siblings Kitty and Lulu, who seem up for anything on a wild party-fuelled night. But little do they know that the femmes fatales want to make Jim lose much more than just his virginity… Getting laid has never been so bloody difficult.","tagline":"Paint the town red"},{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"Double Date","overview":"Jim à l'aube de ses 30 ans est encore vierge. En compagnie d'Alex son compagnon d'infortune, ils vont penser avoir toucher le gros lot en rencontrant Kitty et Lulu, deux superbes filles en quête de sensations fortes. Petit à petit et à leurs dépend ils vont réaliser que les deux femmes fatales ne souhaitent pas se contenter de leur virginité.","tagline":""},{"iso_639_1":"pl","iso_3166_1":"PL","name":"Polski","english_name":"Polish","title":"Podwójna randka","overview":"Jim jest niemal 30-letnim prawiczkiem. Nieśmiały chłopak marzy, by przed urodzinami w końcu spędzić noc z kobietą. Idzie do klubu w towarzystwie zarozumiałego kolegi, Aleksa. Mężczyźni poznają bliźniaczki: Kitty i Lulu. Jim sądzi, że wreszcie los się do niego uśmiechnął. Nie zdaje sobie sprawy, że nowo poznane kobiety zamierzają zabrać mu więcej niż dziewictwo.","tagline":""},{"iso_639_1":"bg","iso_3166_1":"BG","name":"български език","english_name":"Bulgarian","title":"Двойна среща","overview":"Запознайте се с Джим – той се ужасява от момичета, но е решил, че най-накрая ще загуби девствеността си на прага на 30-ия си рожден ден. Той и разгоненият му приятел Алекс решават, че са ударили джакпота, когато се запознават със сексапилните сестри Кити и Лулу. Момичетата изглеждат готови на всичко по време на партито. Приятелите не подозират, че сестрите планират Джим да загуби много повече от девствеността си.","tagline":""},{"iso_639_1":"ru","iso_3166_1":"RU","name":"Pусский","english_name":"Russian","title":"Двойное свидание","overview":"Невинный Джим до смерти боится девушек и робко пытается показать, что он уже мужчина за день до тридцатилетия. Вместе со своим нахальным другом Алексом они думают, что сорвали джекпот, встретив двух симпатчных сестер, Китти и Лулу. Кажется, они готовы пойти на что угодно, и ночью они уходят в отрыв. Но друзья и не подозревали, что роковые женщины хотят лишить Джима не только его девственности. Ради первого секса ещё никогда не приходилось проливать столько крови.","tagline":""},{"iso_639_1":"ko","iso_3166_1":"KR","name":"한국어/조선말","english_name":"Korean","title":"더블 데이트 대 소동","overview":"아직까지 한 번도 못해 본 짐과 그의 불알친구 알렉스는 짐의 동정을 해결하기 위해 헌팅을 나서고 화끈한 자매를 만난다. 그들은 이 매력적인 자매가 연쇄 살인범이라는 사실을 모른 채 더블데이트 약속에 들떠있다. 그들 앞에 펼쳐질 화끈한 밤을 기대하시라.","tagline":"동정남 탈출 프로젝트가 환장할 유혈 소동극으로 바뀌는 순간!"},{"iso_639_1":"el","iso_3166_1":"GR","name":"ελληνικά","english_name":"Greek","title":"","overview":"Ο Τζιμ θα ήθελε πολύ να χάσει την παρθενιά του πριν τα τριάντα. Όμως στο ραντεβού που κανονίζει ο κολλητός του με την Κίτι και τη Λούλου, το μόνο που θα εύχεται είναι να μη χάσει τη ζωή του. Σπαρταριστές δόσεις μαύρου χιούμορ, αποκρυφισμός και κοφτερά μαχαίρια στο πιο διασκεδαστικό, αντι-ρομαντικό φιλμ. Το «Superbad» συναντά το slasher αδερφάκι του υπό τους ήχους των Goat. Ο Άλεξ υπόσχεται στον κολλητό του να τον βοηθήσει να χάσει την παρθενιά του πριν τα τριάντα. Η Κίτι και η Λούλου μοιάζουν η τέλεια ευκαιρία όμως όλα γύρω τους παραείναι ιδανικά για να είναι αληθινά. Δυστυχώς για τον Άλεξ και τον Τζιμ, οι δύο κοπέλες έχουν μια αποτρόπαιη ατζέντα να τηρήσουν. Για τους περισσότερους, το αίμα και το σεξ δεν είναι οι καλύτεροι φίλοι. Αυτήν ακριβώς την αντίθεση, το «Double Date» την χειρίζεται επιθετικά, ακομπλεξάριστα και άκρως διασκεδαστικά.","tagline":""},{"iso_639_1":"es","iso_3166_1":"ES","name":"Español","english_name":"Spanish","title":"","overview":"Conoce al inocente Jim, aterrorizado por las chicas, y en una renuente búsqueda para demostrar su hombría la noche antes de cumplir los 30 años. Él y su engreído amigo Alex creen que han alcanzado el pozo cuando conocen a las hermosas hermanas Kitty y Lulu, que parecen para cualquier cosa en una noche de fiesta salvaje. Pero poco saben que las femmes fatales quieren hacer que Jim pierda mucho más que solo su virginidad. Tener sexo nunca ha sido tan difícil.","tagline":""},{"iso_639_1":"cs","iso_3166_1":"CZ","name":"Český","english_name":"Czech","title":"Dvojitý rande","overview":"Seznamte se s roztomile neškodným panicem Jimem, kterému dívky nahánějí hrůzu. Kvůli zarputilému přesvědčení, že musí přijít v předvečer svých třicátin o panictví, však společně se svým namyšleným kamarádem Alexem podlehne krásným sestrám Kitty a Lulu, které se rády nechávají balit na baru a noci tráví s muži ve svém starém sídle. Přesto jsou stále panny a o svůj stav rozhodně nehodlají přijít. Své panenství si totiž schovávají pro jinou příležitost, k níž budou noční návštěvníky také potřebovat – nejlépe mrtvé! Vrznout si ještě nikdy nebylo tak zatraceně těžké.","tagline":""},{"iso_639_1":"de","iso_3166_1":"DE","name":"Deutsch","english_name":"German","title":"","overview":"Alex will seinem Kumpel Jim zur Nacht seines Lebens verhelfen. Der wird nämlich 30 und ist noch Jungfrau. Alex will diesen Zustand dringend ändern und auch Jim wünscht sich nichts sehnlicher. Als die beiden in einer Bar die verführerischen Schwestern Kitty und Lulu kenennlernen, sehen sie sich schon am Ziel angelangt und gehen natürlich mit ihnen aus - nicht ahnend, dass die beiden Serienmörderinnen auf der Suche nach ihrem nächsten Opfer für ein blutiges Ritual sind.","tagline":""},{"iso_639_1":"nl","iso_3166_1":"NL","name":"Nederlands","english_name":"Dutch","title":"","overview":"Jim is een onschuldige jongen die bang is voor vrouwen. Hij wordt bijna dertig jaar, en is vastbesloten zijn maagdelijkheid te verliezen voor zijn verjaardag. Samen met Alex, een vriend, ontmoet Jim Kitty en Lulu.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"双重约会","overview":"在一次酒吧聚会上，吉姆收到了女友米歇尔的分手短信，震惊之余的他获得了来自朋友亚历克斯衷心的“祝福”，亚历克斯祝福吉姆在30岁到来之前会失去自己的童贞。一天，他偶然遇见了美丽的姐妹露露和凯蒂，在朋友的怂恿下，他鼓起勇气上前搭讪，怎料洋相百出。然而，出乎人意料的是，这对姐妹并不像她们看起来那么单纯无害……","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"雙重約會","overview":"在一次酒吧聚會上，吉姆收到了女友米歇爾的分手短信，震驚之餘的他獲得了來自朋友亞歷克斯衷心的“祝福”，亞歷克斯祝福吉姆在 30 歲到來之前會失去自己的童貞。一天，他偶然遇見了美麗的姐妹露露和凱蒂，在朋友的慫恿下，他鼓起勇氣上前搭訕，怎料洋相百出。然而，出乎人意料的是，這對姐妹並不像她們看起來那麼單純無害……","tagline":""},{"iso_639_1":"ar","iso_3166_1":"SA","name":"العربية","english_name":"Arabic","title":"","overview":"شاب بريء يخشى الفتيات يسعى على مضض، في الليلة السابقة لبلوغه الثلاثين، إلى إثبات رجولته، ويظن هو وصديقه المغرور أنهما فازا با