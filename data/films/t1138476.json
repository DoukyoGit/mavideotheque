ame":"Koji Takimoto","job":"Original Music Composer","department":"Sound","gender":0,"profile_path":null}]},"alternativeTitles":[{"iso_3166_1":"JP","title":"Ribâ, nagarenaide yo","type":""},{"iso_3166_1":"JP","title":"リバー、流れないでよ","type":""},{"iso_3166_1":"GB","title":"River","type":""},{"iso_3166_1":"KR","title":"리버, 흐르지 말아줘","type":""}],"externalIds":{"imdb_id":"tt27695005","wikidata_id":"Q123420912","facebook_id":null,"instagram_id":null,"twitter_id":null},"keywords":[{"id":10854,"name":"time loop"},{"id":180482,"name":"kyoto, japan"},{"id":190531,"name":"speculative"},{"id":197056,"name":"meditative"},{"id":259376,"name":"playful"},{"id":348817,"name":"ryokan"},{"id":366252,"name":"ryoka"}],"releaseDates":[{"iso_3166_1":"CA","release_dates":[{"certification":"PG","descriptors":[],"iso_639_1":"","note":"","release_date":"2023-06-23T00:00:00.000Z","type":2}]},{"iso_3166_1":"DE","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Weird Weekender International Film Festival Stuttgart","release_date":"2023-10-22T00:00:00.000Z","type":1}]},{"iso_3166_1":"ES","release_dates":[{"certification":"12","descriptors":[],"iso_639_1":"","note":"","release_date":"2024-04-19T00:00:00.000Z","type":4}]},{"iso_3166_1":"FR","release_dates":[{"certification":"TP","descriptors":[],"iso_639_1":"ja","note":"PIFFF Paris International Fantastic Film Festival","release_date":"2023-12-09T00:00:00.000Z","type":1},{"certification":"","descriptors":[],"iso_639_1":"","note":"L'Etrange Festival Clermont-Ferrand","release_date":"2024-11-07T00:00:00.000Z","type":1},{"certification":"","descriptors":[],"iso_639_1":"","note":"Saisons Hanabi hiver 2024","release_date":"2024-11-30T00:00:00.000Z","type":2},{"certification":"TP","descriptors":[],"iso_639_1":"","note":"","release_date":"2025-08-13T00:00:00.000Z","type":3}]},{"iso_3166_1":"GB","release_dates":[{"certification":"12","descriptors":[],"iso_639_1":"","note":"","release_date":"2023-10-10T00:00:00.000Z","type":4},{"certification":"12","descriptors":[],"iso_639_1":"","note":"","release_date":"2024-02-12T00:00:00.000Z","type":5}]},{"iso_3166_1":"HK","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Hong Kong Asian Film Festival","release_date":"2023-10-28T00:00:00.000Z","type":1}]},{"iso_3166_1":"ID","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Jogja-NETPAC Asian Film Festival","release_date":"2023-11-26T00:00:00.000Z","type":1}]},{"iso_3166_1":"JP","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"ja","note":"Roadshow","release_date":"2023-06-23T00:00:00.000Z","type":3}]},{"iso_3166_1":"KR","release_dates":[{"certification":"12","descriptors":[],"iso_639_1":"","note":"2025-VF01241 ","release_date":"2025-08-07T00:00:00.000Z","type":4}]},{"iso_3166_1":"PH","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"QCinema International Film Festival","release_date":"2023-11-23T00:00:00.000Z","type":1}]},{"iso_3166_1":"TW","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Golden Horse Fantastic Film Festival","release_date":"2024-04-14T00:00:00.000Z","type":1}]},{"iso_3166_1":"US","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"Fantastic Fest","release_date":"2023-09-24T00:00:00.000Z","type":1},{"certification":"NR","descriptors":[],"iso_639_1":"","note":"","release_date":"2024-04-16T00:00:00.000Z","type":5}]}],"translations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"River","overview":"The one-hundred-year-old Fujiya inn stands in the quiet region of Kyoto. Mikoto is standing in front of the Kibune river at the back of the building when she is called back to work. But two minutes later, she finds herself back at the river again. The whole inn seems to be stuck in a time loop!","tagline":"Another \"two minutes\""},{"iso_639_1":"ja","iso_3166_1":"JP","name":"日本語","english_name":"Japanese","title":"","overview":"京都・貴船の老舗料理旅館「ふじや」で仲居として働くミコトは、別館裏の貴船川のほとりにたたずんでいたところを女将に呼ばれ、仕事へと戻る。だが2分後、なぜか先ほどと同じ場所に立っていた。そしてミコトだけでなく、番頭や仲居、料理人、宿泊客たちもみな、同じ時間がループしていることに気づく。2分経つと時間が巻き戻り、全員元にいた場所に戻ってしまうが、それぞれの記憶は引き継がれるのだ。人々は力をあわせてタイムループの原因究明に乗り出すが、ミコトはひとり複雑な思いを抱えていた。","tagline":"また2分。"},{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"En boucle","overview":"Une nouvelle journée commence à l’auberge Fujiya, nichée au cœur des montagnes japonaises. Une journée ordinaire… ou presque : car les uns après les autres, les employés et les clients se rendent compte que les mêmes 2 minutes sont en train de se répéter à l’infini… Certains veulent en sortir, d’autres préfèrent y rester, mais tous cherchent à comprendre ce qui leur arrive.","tagline":"Ils ne sont pas sortis de l'auberge !"},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"别流淌呀，河水","overview":"某个宁静冬日，京都贵船的料理旅馆老店藤屋。站在贵船川旁的服务生美琴（藤谷理子 饰）被女将（本上真奈美 饰）叫回去工作。可是，两分钟后，她发现自己再次站在河边。而且不止她，旅馆里的其他员工和住客都开始觉得奇怪，他们发现自己被困在两分钟的循环之中。两分钟后，时间倒转，一切又回到原处，但他们的记忆却依然保留。众人决定合力找出事件背后的原因，但美琴却心情复杂…","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"河邊溝流流","overview":"口碑爆棚嘅《超越無限兩分鐘》班底又嚟料！今次場景搬去貴船川旁的古宅旅館，原本一切好地地，突然眾人發現明明兩分鐘前做好的事情，兩分鐘後又打回原形：火鍋煲粥食極都食唔完、作家房客完成的稿件每兩分鐘消失一次；老闆娘、經理、廚師、執房阿姐同所有客人，全員一齊被困無限輪迴，唯獨記憶繼續進行，混亂中大家開始情緖失控……到底點收科？京都著名劇團 EuropeKikaku 第二次將舞台的移形換影調度成大銀幕上的奇幻喜劇，導演山口淳太再度夥拍編劇上田誠，打開新世界大門繼續無限 loop，將時間反轉再反轉。","tagline":""},{"iso_639_1":"zh","iso_3166_1":"TW","name":"普通话","english_name":"Mandarin","title":"無限泡湯兩分鐘","overview":"冬日的京都裡，百年溫泉旅館貴船臨河而建，服務員美琴準備展開一天的工作，卻發現整間旅館陷入不斷重複的兩分鐘迴圈。不僅住客驚慌失措，員工們更是手忙腳亂，眾人試圖循線突破僵局，難道真的有河神以愛之名讓時光駐足嗎？","tagline":""},{"iso_639_1":"de","iso_3166_1":"DE","name":"Deutsch","english_name":"German","title":"River - The Timeloop Hotel","overview":"Im kleinen japanischen Örtchen Kibune scheint die Zeit stillzustehen: Buchstäblich! Die Hotelangestellte Mikoto staunt nicht schlecht, als sie sich plötzlich am kleinen Fluss hinter der alten Herberge wiederfindet. Immer und immer wieder! Mikoto, ihre Arbeitskollegen und die illustre Schar an Hotelgästen scheinen in einem Zeit-Loop gefangen, der sie sekundengenau nach zwei Minuten wieder an ihre “Ausgangspositionen” zurücksetzt. Während einige Hotelgäste schnell dabei sind, den Verstand zu verlieren, suchen andere nach einem Ausweg und merken bald, dass hier offenbar übersinnliche Geschehnisse die Zeit verrückt spielen lassen.","tagline":""},{"iso_639_1":"es","iso_3166_1":"ES","name":"Español","english_name":"Spanish","title":"Atrapados en un bucle infinito","overview":"Mikoto trabaja en una pequeña posada en Kibune y el día parece desarrollarse con normalidad: los múltiples huéspedes y trabajadores tienen cada uno sus preocupaciones y obligaciones cotidianas. Un tanto abrumada, se toma un descanso frente al río, pero cuando regresa ya nada es igual: ¡toda la posada ahora se encuentra atrapada en un bucle temporal de tan solo dos minutos!","tagline":""},{"iso_639_1":"it","iso_3166_1":"IT","name":"Italiano","english_name":"Italian","title":"River","overview":"","tagline":""},{"iso_639_1":"ca","iso_3166_1":"ES","name":"Català","english_name":"Catalan","title":"Atrapats en un bucle infinit","overview":"En un hostal centenari, una treballadora acaba el descans a la vora d'un riu proper i torna a la feina. El dia transcorre amb normalitat fins que, dos minuts després, tot torna a començar. I no és només ella: cambrers, xefs, convidats... Dos minuts no són suficients per sortir del bucle, però sí per determinar el pas següent.","tagline":""},{"iso_639_1":"ko","iso_3166_1":"KR","name":"한국어/조선말","english_name":"Korean","title":"2분마다 타임루프","overview":"교토 도심에서 떨어진 곳에 위치한 키부네. 키부네에는 평화로운 분위기의 료칸 ‘후지야’가 있다. 언제나 친절한 미소와 단정한 몸가짐으로 손님을 응대하는 ‘후지야’ 직원들. 그런데 별다를 것 없이 유유히 흘러가던 키부네의 일상에 뜻밖의 이변이 일어나는데… 다름아닌 정확히 2분마다 시간이 되돌아가는 타임 루프! 매회 주어지는 시간은 단 2분. 직원들과 손님들은 이상현상의 원인을 규명하고 루프를 끊어내 원래의 일상을 되찾을 수 있을까?","tagline":"자꾸만... 되돌아간다!"},{"iso_639_1":"zh","iso_3166_1":"SG","name":"普通话","english_name":"Mandarin","title":"無限泡湯兩分鐘","overview":"倒完又斟滿的酒瓶、無限增生的雜炊飯、重複下筆又消失的小說段落。倚著潺潺流水的京都貴船百年旅館，突如其來迎接不斷重複的兩分鐘！無止盡的時間迴圈，不只衝擊住客，也讓員工們手忙腳亂，眾人循線逐題破解試圖逃出生天，越破解卻越難以理解，難道眞有河神以愛之名，讓時光在此佇留？","tagline":""},{"iso_639_1":"es","iso_3166_1":"MX","name":"Español","english_name":"Spanish","title":"Atrapados en un bucle infinito","overview":"En un tranquilo día de invierno, una posada de montaña queda atrapada en un bucle temporal.","tagline":""},{"iso_639_1":"sv","iso_3166_1":"SE","name":"svenska","english_name":"Swedish","title":"River","overview":"En stillsam vinterdag fastnar gäster och personal på ett litet japanskt värdshus i en tidsloop och återupplever samma två minuter om och om igen. Det hundraåriga värdshuset Fujiya ligger i den stillsamma Kyoto-regionen, i ett naturskönt landskap. Värdinnan Mikoto står och betraktar Kiubunefloiden, när värdshusets ägare kallar på henne. Plötsligt, två minuter senare, finner sig Mikoto återigen stående vid floden. Hela värdshuset har fastnat i vad som verkar vara en tidsloop. Trots att samma två minuter återupprepas gång på gång behåller de alla sina minnen och tillsammans försöker gästerna och personalen att finna ett sätt att kunna ta sig ut ur tidens eviga upprepning.","tagline":""},{"iso_639_1":"ar","iso_3166_1":"SA","name":"العربية","english_name":"Arabic","title":"","overview":"نُزل عمره مئة عام في منطقة هادئة من كيوتو، تقف إحدى العاملات عند النهر خلف المبنى حين تُستدعى إلى العمل، لكنها بعد دقيقتين تجد نفسها عند النهر مجددًا، فالنزل كله عالق في حلقة زمنية مدتها دقيقتان، في كوميديا.","tagline":""}],"videos":[{"key":"xPlQyLuYGhQ","site":"YouTube","type":"Clip","name":"EN BOUCLE ⌛️ | 36 plans-séquences de 2 minutes !","iso_639_1":"fr","official":false,"published_at":"2025-06-25T15:33:34.000Z","size":1080},{"key":"NM2uNvRyM_E","site":"YouTube","type":"Trailer","name":"⌛ EN BOUCLE | La bande-annonce","iso_639_1":"fr","official":false,"published_at":"2025-06-18T12:10:11.000Z","size":1080},{"key":"rz6EYCRo3Is","s