nslations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"Intimate Confessions of a Chinese Courtesan","overview":"18-year-old Ainu is kidnapped and sold to a brothel. Her good looks and wild personality make her very popular with the lustful clients, but also draw the lesbian attentions of brothel madam Chun Yi. Chun Yi teaches Ainu the ways of lust and the ways of kung fu, and Ainu becomes more and more similar to her captor. But rage at her treatment is still burning inside her.","tagline":"The first Chinese sex film!"},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"爱奴","overview":"教书匠之女爱奴被拐卖到妓院“四季春”，因其容貌脱俗，个性刚烈，遂得鸨母春姨另眼相看。春姨稳坐四季春第一把交椅，与同僚包虎共同经营。包虎一直深爱春姨，却无法如愿。只因春姨癖好独特，专好女色，嗜女如命。爱奴的出现让春姨眼前一亮，遂百般威逼利诱，要将其培养成头牌。为保清白，爱奴誓死不从。势单力薄，春姨强迫其接客，爱奴惨遭众豪绅蹂躏。身心俱创的爱奴只求一死，却被哑巴少年救下，原来少年只是装哑，实则另有苦衷。二人潜逃被抓，少年为救爱奴而死。爱奴为复仇，于是违心就范。一面讨好春姨，投其所好成为其同性爱侣。一面随其学习武功奇技。孤女的复仇计划能否成功？","tagline":""},{"iso_639_1":"hu","iso_3166_1":"HU","name":"Magyar","english_name":"Hungarian","title":"Egy kínai kurtizán intim vallomásai","overview":"","tagline":""},{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"Ai Nu, Esclave de L'Amour","overview":"Ai Nu, 18 ans, est kidnappée et vendue à une maison close. Sa belle apparence et sa personnalité sauvage la rendent très populaire auprès des clients lascifs, mais elle attire également les attentions lesbiennes de la tenancière de la maison close, Chun Yi. Chun Yi enseigne à Ai Nu les voies de la luxure et celles du kung-fu, et Ai Nu devient de plus en plus semblable à son ravisseur. Mais la rage de son traitement brûle toujours en elle.","tagline":""},{"iso_639_1":"ko","iso_3166_1":"KR","name":"한국어/조선말","english_name":"Korean","title":"애노","overview":"","tagline":""},{"iso_639_1":"it","iso_3166_1":"IT","name":"Italiano","english_name":"Italian","title":"","overview":"L’innocente Ai Nu viene venduta a un bordello gestito dalla malvagia Chun Yi, che si innamora subito di lei. Presto la giovane diventa la cortigiana più desiderata del bordello e scala la piramide della società cinese, senza smettere mai di architettare la sua vendetta.","tagline":""},{"iso_639_1":"pt","iso_3166_1":"BR","name":"Português","english_name":"Portuguese","title":"Confissões Íntimas de uma Cortesã Chinesa","overview":"A inocente Ai Nu é vendida para um bordel administrado pela malvada Madame Chun Yi, que se apaixona por ela imediatamente. Ai Nu logo se torna a cortesã mais desejada do bordel e sobe na hierarquia da sociedade chinesa, enquanto planeja secretamente sua vingança contra todos os que a prejudicaram.","tagline":""},{"iso_639_1":"es","iso_3166_1":"ES","name":"Español","english_name":"Spanish","title":"Confesiones íntimas de una cortesana china","overview":"Se ha cometido un asesinato y una conocida cortesana es la única sospechosa. Pudiera ser que la chica se haya adiestrado en las artes marciales y del sexo para consumar una venganza.","tagline":""},{"iso_639_1":"th","iso_3166_1":"TH","name":"ภาษาไทย","english_name":"Thai","title":"รสรักฤทธิ์แค้น","overview":"ไอนุสาววัย 18 ปีถูกลักพาตัวไปขายให้กับซ่อง หน้าตาดีและบุคลิกที่ดิบเถื่อนของเธอทำให้เธอเป็นที่นิยมในหมู่ลูกค้าที่หลงใหลในกาม แต่ก็ดึงดูดความสนใจจากหญิงรักร่วมเพศอย่างชุนอี ซ่อง ชุนอีสอนวิถีแห่งกามและกังฟูให้กับไอนุ ทำให้ไอนุยิ่งมีลักษณะคล้ายกับผู้จับกุมเธอมากขึ้นเรื่อยๆ แต่ความโกรธแค้นจากการกระทำของเธอยังคงคุกรุ่นอยู่ในตัวเธอ","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"愛奴","overview":"教書匠之女愛奴被拐賣到妓院“四季春”，因其容貌脱俗，個性剛烈，遂得鴇母春姨另眼相看。春姨穩坐四季春第一把交椅，與同僚包虎共同經營。包虎一直深愛春姨，卻無法如願。只因春姨癖好獨特，專好女色，嗜女如命。愛奴的出現讓春姨眼前一亮，遂百般威逼利誘，要將其培養成頭牌。為保清白，愛奴誓死不從。勢單力薄，春姨強迫其接客，愛奴慘遭眾豪紳蹂躪。身心俱創的愛奴只求一死，卻被啞巴少年救下，原來少年只是裝啞，實則另有苦衷。二人潛逃被抓，少年為救愛奴而死。愛奴為復仇，於是違心就範。一面討好春姨，投其所好成為其同性愛侶。一面隨其學習武功奇技。孤女的復仇計劃能否成功？","tagline":""},{"iso_639_1":"zh","iso_3166_1":"TW","name":"普通话","english_name":"Mandarin","title":"","overview":"柔弱少女金娥，被賣入妓院強迫接客，受盡欺凌，悲憤之餘，假意奉承，化名愛奴，跟鴇母春姨學習奇特武功，又投其所好與春發展一段同性戀，目的就是報仇，後來愛奴將曾競投她初夜的嫖客逐一殺死……","tagline":""}],"videos":[{"key":"G1MvBXRcVaE","site":"YouTube","type":"Trailer","name":"Intimate Confessions of a Chinese Courtesan (1972) ORIGINAL TRAILER","iso_639_1":"en","official":false,"published_at":"2021-11-22T00:37:09.000Z","size":1080},{"key":"8Slp6jdu2DA","site":"YouTube","type":"Trailer","name":"Intimate Confessions of A Chinese Courtesan 愛奴 (1972) **Official Trailer** by Shaw Brothers","iso_639_1":"en","official":true,"published_at":"2013-04-19T06:42:16.000Z","size":480}],"images":{"posters":[{"file_path":"/gsRygZCTyQYXJ7TclTiafnCm6jV.jpg","width":2000,"height":3000,"iso_639_1":"en","vote_average":3.334,"vote_count":1},{"file_path":"/d8BxiNBxPL1nFMunRaXI2MAYPCB.jpg","width":960,"height":1440,"iso_639_1":"en","vote_average":1.35,"vote_count":10},{"file_path":"/aGLzNHKZW2fhOROeAJYN7lgelDs.jpg","width":828,"height":1182,"iso_639_1":"en","vote_average":1.222,"vote_count":3}],"backdrops":[{"file_path":"/3y2BtcjEm4yhMystxeOh46u35dH.jpg","width":1280,"height":720,"iso_639_1":null,"vote_average":3.334,"vote_count":1},{"file_path":"/yrfOq22B1BQWiu6DLuTV0p3e9H5.jpg","width":1280,"height":720,"iso_639_1":null,"vote_average":3.334,"vote_count":1},{"file_path":"/2x9WvhR9KOqfKUH5i4HrV1PlSfR.jpg","width":1440,"height":810,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/3IRhVW8Xlu2P8XEsKmNWfnSSP4b.jpg","width":1600,"height":901,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/b1tXWBqmwvjUzKf6Eyt5u0BhX1t.jpg","width":3839,"height":2160,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/sHyBN9rJY8QnrYjNaChWnxSNwrG.jpg","width":1280,"height":720,"iso_639_1":"en","vote_average":0,"vote_count":0},{"file_path":"/v3sxaujeV6ygwg9XCBdUPH4jXBC.jpg","width":1920,"height":1080,"iso_639_1":null,"vote_average":0,"vote_count":0}],"logos":[{"file_path":"/mhldCPy5CTTBJvqmDDG3KqypMIa.png","width":551,"height":178,"iso_639_1":"en","vote_average":0,"vote_count":0}]},"recommendations":[{"id":263341,"title":"