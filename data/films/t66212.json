"profile_path":"/d4doL1fc0TCcQqgFvkB8fRRpa1F.jpg"},{"id":68328,"name":"劉滿棠","original_name":"劉滿棠","job":"Director of Photography","department":"Camera","gender":2,"profile_path":null},{"id":46326,"name":"張耀宗","original_name":"張耀宗","job":"Editor","department":"Editing","gender":2,"profile_path":null},{"id":25245,"name":"Jacky Cheung","original_name":"張學友","job":"Songs","department":"Sound","gender":2,"profile_path":"/eoh2sI1IBYmQSuIapr32EUbl3Nw.jpg"}]},"alternativeTitles":[{"iso_3166_1":"GB","title":"Above The Law","type":"video title"},{"iso_3166_1":"HK","title":"執法先鋒","type":""},{"iso_3166_1":"RU","title":"Над законом","type":""},{"iso_3166_1":"US","title":"Above the Law","type":""},{"iso_3166_1":"CL","title":"Zhi Fa Xian Feng","type":"romanization"},{"iso_3166_1":"KR","title":"사대선봉","type":""},{"iso_3166_1":"BR","title":"Na Beira do Abismo","type":""}],"externalIds":{"imdb_id":"tt0094374","wikidata_id":"Q4311819","facebook_id":null,"instagram_id":null,"twitter_id":null},"keywords":[{"id":779,"name":"martial arts"},{"id":780,"name":"kung fu"},{"id":8015,"name":"cop"},{"id":7002,"name":"vigilante"},{"id":10909,"name":"lawyer"},{"id":12354,"name":"hong kong"}],"releaseDates":[{"iso_3166_1":"HK","release_dates":[{"certification":"IIB","descriptors":[],"iso_639_1":"","note":"","release_date":"1986-11-27T00:00:00.000Z","type":3}]}],"translations":[{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"Righting Wrongs","overview":"Jason Chan, a Hong Kong lawyer, is angry at the way the law protects criminals and decides to take the law into his own hands, dishing out vigilante justice when a key witness and his entire family are murdered. But hotshot cop Cindy Si is soon on Chan's case, and the situation unravels into a fight that only a few will survive.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"执法先锋","overview":"一腔热血、正义感十足的夏令正（元彪 饰）曾经目睹恩师光天化日之下被人残忍杀害的血腥一幕，而他不为所惧，愈加坚定了主持正义、惩恶扬善的信念。某天，身为检察官的夏令正指控两个臭名昭著的恶徒走私贩毒、谋财害命。谁知就在庭审的关键时刻，他好不容易说服的污点证人梁二胜一家八口被人残忍杀害。嫌疑人靠如此丧尽天良的手段逃脱一劫，致令夏令正大为恼火。在此之后，他铤而走险，跨越了检察官的底线，趁夜入室将嫌疑人之一的老卫（张冲 饰）以法外手段杀死。当他将下一个目标锁定在老周（田俊 饰）身上时，却发现对方已被人先行杀害。警界黑手渐渐浮出水面，而孤狼一匹的夏令正沿着正义之路急速狂奔……","tagline":""},{"iso_639_1":"de","iso_3166_1":"DE","name":"Deutsch","english_name":"German","title":"Tage des Terrors","overview":"Als Zwei grosse Schmuggler von Gericht freigesprochen werden, nur weil der einzige Zeuge, der aussagen sollte, Opfer eines Attentats wurde, hat der Anwalt Jason Chan die Nase gestrichen voll, und nimmt das Gesetz in die eigenen Hände. Bald schon bekommen die Verbrecher Angst, als eine nach dem anderen getötet wird. Doch ist Chan wirklich der gnadenlose Killer???","tagline":""},{"iso_639_1":"ru","iso_3166_1":"RU","name":"Pусский","english_name":"Russian","title":"Зло во благо","overview":"Молодой юрист Ся Лин-Чин собрал много томов документов, обвиняющих короля уголовного мира в совершении ряда преступлений. Но накануне судебного заседания мафия отправила на тот свет главного свидетеля. После чего Ся Лин-Чин понял, что пришла пора вершить правосудие собственными руками…","tagline":""},{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"Une flic de choc","overview":"Yuen Biao incarne Jason Chan comme un avocat, en colère contre la façon dont la loi semble protéger les méchants, il décide de prendre la loi entre ses mains quand un témoin clé et toute sa famille sont assassinés. mais Cindy Si est bientôt sur son cas et tout tourne dans une situation que quelques-uns survivront.","tagline":""},{"iso_639_1":"bg","iso_3166_1":"BG","name":"български език","english_name":"Bulgarian","title":"Отвъд закона","overview":"Ся Лин-Чън е отдаден на работата си и стриктен прокурор, който прави всичко възможно да запази търпението и толерантността си, въпреки несигурната съдебна система. Но когато менторът му е застрелян на публично място, а основният свидетел в най-новото му дело и семейството му са избити, Ся решава да вземе правосъдието в свои ръце. Планът му за саморазправа включва убийство на двамата мъже, които смята за отговорни за смъртта на свидетеля. Ся убива първия и това принуждава хонконгската полиция да се намеси, опитвайки се да възстанови реда. Случаят се възлага на старши инспектор Синди Си и нейния началник сержант Уон Дзин-уай. Но когато Ся се опитва да отстрани втората си мишена, мъжът вече е мъртъв. Оказва се, че без да знаят, престъпниците са работили за още по-голям злодей, известен само като \"Короната\". НАГРАДИ И НОМИНАЦИИ Хонконгски филмови награди '87 - Номинация за поддържаш актьор (У Ма) и най-добра екшън хореография","tagline":""},{"iso_639_1":"ko","iso_3166_1":"KR","name":"한국어/조선말","english_name":"Korean","title":"집법선봉","overview":"법정 증인으로 세우려던 승숙이 살해되자 기소를 철회하게 된 검사 원표는, 책임을 느끼고 마약밀매 조직의 두목인 장충을 살해한다. 왕국장의 명으로 범인을 색출하던 여형사 나부락과 원규는, 원표에게 혐의를 두고 그를 감시한다. 감시망을 피해 악당 전준을 살해하려던 원표는, 소년 도둑인 문자에게 왕국장이 이미 전준을 해하였음을 듣고, 그가 고용한 서양인 킬러를 살해한다. 음모에 말려 문자가 사경을 헤메는 가운데 나부락과 합세한 원표는, 경비행기를 몰고 도주하는 왕국장과 공중전을 벌인다.  왕국장을 살해 한 뒤, 구사일생으로 목숨을 건진 원표는 재판을 받고 유죄 판결로 수감되는데...","tagline":""},{"iso_639_1":"pl","iso_3166_1":"PL","name":"Polski","english_name":"Polish","title":"Poza Prawem","overview":"Prokurator (Yuen Biao), po nieudanym procesie dwóch mafiozów, po tym jak główny świadek zostaje wraz z całą rodziną zamordowany, postanawia sam wymierzyć sprawiedliwość. Ale nie tylko on działa poza prawem... o czym również przekona się ścigająca  prokuratora dzielna policjantka (Cynthia Rothrock).","tagline":""},{"iso_639_1":"zh","iso_3166_1":"TW","name":"普通话","english_name":"Mandarin","title":"執法先鋒","overview":"年輕的檢控官元彪接辦首宗要案，起訴大毒梟張沖、田俊，說服重點證人勝叔出庭作證。怎料開庭前勝叔舉家遭殘殺，控方因證據不足而撤銷控罪。彪深感內疚，亦知無法按正途懲治主謀，乃乘夜到張沖家將之擊斃，黃局長遂命洋師姐羅芙洛及探員緝捕兇手，終認定元彪是兇手，彪獨闖田家後，欲將之正法，卻發現田已死去。小偷文仔同睹真兇為警官，準備通知彪，卻被警官搶先滅口。彪查明警官與毒梟早有勾結，與探員聯手追擊並將其擊斃。法庭開庭審判彪殺死警官一案，召探員出庭作證，而探員此時已乘飛機回國。","tagline":""},{"iso_639_1":"es","iso_3166_1":"ES","name":"Español","english_name":"Spanish","title":"Al borde de la ley","overview":"Yuen Biao interpreta a Jason chan, después de terminar sus estudios sobre leyes en Inglaterra vuelve a Hong Kong para hacerse abogado. Con un fuerte sentido de la justicia, el intento de Jason de condenar a algunos señores de la droga para sus crímenes no funcionan. Van siempre libremente ... y la ley apenas sirve de nada, la cólera se acumula en Jason hasta que decide tomarse la justicia por su mano. Asignan a Sandy (Cynthia Rothrock) una detective de Hong Kong para investigar un nuevo caso sobre el asesinato de varios señores de la droga.","tagline":""},{"iso_639_1":"zh","iso_3166_1":"HK","name":"普通话","english_name":"Mandarin","title":"執法先鋒","overview":"接辦首宗案件的年輕檢察官元彪，起訴大毒梟張沖、田俊，説服勝叔出庭頂證後，擔保安全。開番前因勝叔一家遭殘殺，而撤銷控訴。元彪感到應負責任，且有感於正當法律途徑實難將大奸大惡繩之於法，某夜，元彪到張沖處，將他擊斃。\r 警方，黃局長派洋師姐羅芙洛及新調到任便衣探員元奎負責緝捕兇手歸案。羅芙洛蒐集蛛絲馬跡，憑精明頭腦分析，認定元彪嫌疑最大，遂展開對彪偵查行動。彪擺脱監視，直闖田俊家，欲殺田俊，卻出意料發覺田俊已遭人殺害，且被羅當場出現擒彪……","tagline":""},{"iso_639_1":"it","iso_3166_1":"IT","name":"Italiano","english_name":"Italian","title":"Righting Wrongs","overview":"","tagline":""},{"iso_639_1":"hu","iso_3166_1":"HU","name":"Magyar","english_name":"Hungarian","title":"Törvényen kívül","overview":"Egy ügyész megelégeli, hogy a rendszer impotenciája miatt képtelen rács mögé juttatni egy bűnszövetkezet két vezetőjét, ezért úgy dönt, maga végez velük. Egy rendőrnő azonban a nyomába ered.","tagline":""},{"iso_639_1":"pt","iso_3166_1":"BR","name":"Português","english_name":"Portuguese","title":"Na Beira do Abismo","overview":"Yuen Biao faz de Jason Chan um advogado, irritado com a forma como a lei parece proteger os bandidos, ele decide tomar a lei em suas próprias mãos quando uma testemunha chave e toda sua família são assassinados. mas Cindy Si está em breve em seu caso e tudo se transforma em espiral em uma situação que só alguns poucos sobreviverão.","tagline":"Quando o mal usa um distintivo, a justiça está acima da lei."},{"iso_639_1":"th","iso_3166_1":"TH","name":"ภาษาไทย","english_name":"Thai","title":"ตุลาการสั่งตาย","overview":"เจสัน ชาน ทนายความชาวฮ่องกง โกรธแค้นต่อกฎหมายที่ปกป้องอาชญากร และตัดสินใจใช้อำนาจตามกฎหมายด้วยมือตัวเอง โดยให้ความยุติธรรมแก่ผู้กระทำความผิด เมื่อพยานคนสำคัญและครอบครัวของเขาถูกฆาตกรรม แต่ไม่นาน ตำรวจสาว ซินดี้ ซี ก็เข้ามาดำเนินคดีกับชาน และสถานการณ์ก็กลายเป็นการต่อสู้ที่คนเพียงไม่กี่คนเท่านั้นที่จะรอดชีวิต","tagline":""},{"iso_639_1":"vi","iso_3166_1":"VN","name":"Tiếng Việt","english_name":"Vietnamese","title":"Chấp Pháp Tiên Phong","overview":"Jason Chan, một luật sư Hồng Kông, tức giận với cách luật pháp bảo vệ tội phạm và quyết định tự mình thực hiện luật pháp, thực thi công lý khi một nhân chứng quan trọng và toàn bộ gia đình anh ta bị sát hại. Nhưng cảnh sát tài giỏi Cindy Si sẽ sớm vào cuộc trong vụ án của Chan, và tình hình trở nên căng thẳng dẫn đến một cuộc chiến mà chỉ một số ít người sống sót.","tagline":""},{"iso_639_1":"cs","iso_3166_1":"CZ","name":"Český","english_name":"Czech","title":"Dny teroru","overview":"Dříve bojoval svou výřečností, když hájil právo v zemi plné bezpráví. Nelítostné vyvraždění svědkovy rodiny ho donutilo k akci - začal spravedlnost hájit bojem, když soudy jsou bezmocné. Je mu ale v patách ke všemu odhodlaná policistka, která neví, že někdo najal vrahy, aby překazili vykonání spravedlnosti. Někdo, kdo stojí neviditelně v pozadí za všemi vraždami. Někdo, kdo je jí blíže, než by si mohla představit. Spravedlnost na sebe může brát různé podoby, někdy je víc než zákon.","tagline":""}],"videos":[{"key":"jJK0cMB7nMs","site":"YouTube","type":"Trailer","name":"Righting Wrongs / Above the Law (1986) Original Trailer [FHD]","iso_639_1":"en","official":false,"published_at":"2023-08-10T13:14:48.000Z","size":2160},{"key":"ScrV9_eRWdQ","site":"YouTube","type":"Teaser","name":"Export Trailer","iso_639_1":"en","official":true,"published_at":"2022-09-01T12:18:10.000Z","size":1080},{"key":"H9-VDN5Qsmo","site":"YouTube","type":"Teaser","name":"Deluxe Blu-ray Edition Trailer","iso_639_1":"en","official":true,"published_at":"2022-07-01T14:00:18