 Земята е плоска.\r Филмът се опитва да даде една по-скоро антропологическа перспектива за живота на тази група чудаци, докато търси отговора на въпроса възможен ли е диалог с тях. С това той дава възможност на зрителя не само да се запознае с техния живот, но и с гледната точка на различни учени към теорията за плоската земя и нейните последователи.","tagline":""}],"videos":[{"key":"Gnsm81gjo1E","site":"YouTube","type":"Trailer","name":"Behind the Curve - Official Teaser Trailer","iso_639_1":"en","official":false,"published_at":"2018-04-27T14:36:40.000Z","size":1080}],"images":{"posters":[{"file_path":"/mOJrtSMmUpfFytvxlUEA8hej2At.jpg","width":2000,"height":3000,"iso_639_1":"en","vote_average":3.334,"vote_count":1},{"file_path":"/nliiSYmICiNNHTFuqfiu1uppThM.jpg","width":2000,"height":3000,"iso_639_1":"en","vote_average":3.334,"vote_count":1},{"file_path":"/rGT9MUIyZ0cC4lcjM2Dw0lGbxnu.jpg","width":662,"height":1000,"iso_639_1":"en","vote_average":0,"vote_count":0},{"file_path":"/j9i9rLkBvA0f5eG423pFqy3TOSP.jpg","width":1000,"height":1500,"iso_639_1":"en","vote_average":0,"vote_count":0},{"file_path":"/7TkcHJX2lzx5BJdsHe4SdaIs6oM.jpg","width":2000,"height":3000,"iso_639_1":null,"vote_average":0,"vote_count":0}],"backdrops":[{"file_path":"/imRVEUDwJdISrfckUllkBQHUkc8.jpg","width":1920,"height":1080,"iso_639_1":null,"vote_average":3.334,"vote_count":1},{"file_path":"/zsytDny4ZjyiwqFRBlXvzspwlUH.jpg","width":1440,"height":810,"iso_639_1":null,"vote_average":0.166,"vote_count":1},{"file_path":"/wB8sK40u27FQjWZgc1LhYZixpC6.jpg","width":1920,"height":1080,"iso_639_1":null,"vote_average":0.166,"vote_count":1},{"file_path":"/mFwrZdGWiGkZp3NN5fCKARukDq2.jpg","width":1280,"height":720,"iso_639_1":null,"vote_average":0,"vote_count":0},{"file_path":"/4P9v5kL8x5zCHrf3srMGWahLMOX.jpg","width":1280,"height":720,"iso_639_1":"en","vote_average":0,"vote_count":0},{"file_path":"/tdjBSTWgnSSP8zltFWfzWkGzMXa.jpg","width":1280,"height":720,"iso_639_1":"en","vote_average":0,"vote_count":0}