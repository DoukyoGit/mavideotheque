{"id":"t38155","key":"suk san sun suk san geen hap|1983","csv":{"title":"Suk san: Sun Suk san geen hap","year":1983,"directors":["Tsui Hark"],"rating":6,"watchedDate":"2021-10-13"},"status":"ok","tmdb":{"tmdbId":38155,"imdbId":"tt0086308","wikidataId":"Q2618599","title":"Zu, les guerriers de la montagne magique","originalTitle":"新蜀山劍俠","altTitles":["Zu: The Warriors from the Magic Mountain","Zu Mountain: New Legend of the Zu Mountain Swordsmen","Suk saan: San suk saan gim hap","蜀山：新蜀山劍俠","Shu Shan - Xin Shu shan jian ke","Xin shu shan jian xia","Shokusan kifu: tenkuu no ken","Войны Зу","Zu: Warriors of the Magic Mountain","Zu Warriors from the Magic Mountain","Zu: Warriors from Magic Mountain","Zu Time Warrior","Zu Warriors","Zu: Os Guerreiros da Montanha Encantada"],"tagline":"","overview":"Dans les montagnes sacrées de Zu, un monstre aux pouvoirs immenses tente de renaître. De courageux chevaliers, avec l'appui d'un jeune éclaireur, ont 49 jours pour sauver le monde.","overviewLang":"fr","releaseDate":"1983-02-05","runtime":98,"status":"Released","genres":["Fantastique","Action","Aventure","Comédie"],"genreIds":[14,28,12,35],"countries":["Hong Kong"],"originCountry":["HK"],"languages":["广州话 / 廣州話"],"originalLanguage":"cn","directors":["Tsui Hark"],"directorIds":[26760],"writers":["Li Shoumin","Shui Chung-Yuet","司徒卓漢"],"composers":["鄧少林"],"cinematographers":["黃仲標"],"editors":["張耀宗"],"producers":["鄒文懷"],"cast":[{"id":62410,"name":"Sammo Kam-Bo Hung","character":"Chang Mei / Red Army Soldier","profilePath":"/AsB9uRDQWdIbFGnkICEl8I2gDWn.jpg"},{"id":62414,"name":"Yuen Biao","character":"Di Ming Qi / Dik Ming Kei","profilePath":"/pgO9Im1QKPjLozvsWODLtZDTjw7.jpg"},{"id":82401,"name":"鄭少秋","character":"Ding Yin / Ding Yan","profilePath":"/KHy7b3kAXP05VGcdsPy3Qf34GM.jpg"},{"id":56830,"name":"Brigitte Lin","character":"Ice Queen","profilePath":"/niZ0gRf1lvw9gbUvrC3LIvRkaCI.jpg"},{"id":544779,"name":"Moon Lee","character":"Ice Queen's Guard","profilePath":"/2wTS5wK0tlbtHvNYm