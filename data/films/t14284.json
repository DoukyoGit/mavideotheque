{"id":"t14284","key":"in the shadow of the moon|2007","csv":{"title":"In the Shadow of the Moon","year":2007,"directors":["David Sington"],"rating":4,"watchedDate":"2026-08-25"},"status":"ok","tmdb":{"tmdbId":14284,"imdbId":"tt0925248","wikidataId":"Q2704813","title":"Dans l'ombre de la Lune","originalTitle":"In the Shadow of the Moon","altTitles":["Im Schatten des Mondes"],"tagline":"","overview":"Entre 1968 et 1972, les USA ont envoyé 24 astronautes dans l'espace. Leur but : se poser sur la Lune. À travers des archives inédites, les survivants des missions Apollo racontent leurs aventures, dans leurs propres mots…","overviewLang":"fr","releaseDate":"2007-01-19","runtime":95,"status":"Released","genres":["Documentaire","Histoire"],"genreIds":[99,36],"countries":["United States of America","United Kingdom"],"originCountry":["US","GB"],"languages":["English"],"originalLanguage":"en","directors":["David Sington"],"directorIds":[86662],"writers":[],"composers":[],"cinematographers":[],"editors":[],"producers":["Belinda Blacklock"],"cast":[{"id":106843,"name":"Buzz Aldrin","character":"Himself","profilePath":"/gUuAUCEAR3ut3ZX1a5iiz5tegk0.jpg"},{"id":106840,"name":"Michael Collins","character":"Himself","profilePath":null},{"id":595477,"name":"Alan Bean","character":"Himself","profilePath":null},{"id":106839,"name":"Eugene Cernan","character":"Himself","profilePath":null},{"id":1195357,"name":"Charlie Duke","character":"Himself","profilePath":"/eyZiNBkrGx8FrBSZpuLuK9MEb2R.jpg"},{"id":7852,"name":"Jim Lovell","character":"Himself","profilePath":"/fTxVmhcG3noMlycNvIJLcffumcj.jpg"},{"id":87488,"name":"Edgar D. Mitchell","character":"Himself","profilePath":"/jqtdkPqw8jqKvfeFcmVEI5WB6bA.jpg"},{"id":1195360,"name":"Harrison Schmitt","character":"Himself","profilePath":null},{"id":106844,"name":"John Young","character":"Himself","profilePath":"/72f5ZgWnxMwMv2GwG0Kt3rKvRpq.jpg"}],"companies":["Discovery Films","Passion Pictures","Film4 Productions","DOX Productions","Polyband"],