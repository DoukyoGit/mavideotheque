ive title"},{"iso_3166_1":"RO","title":"Asul asilor","type":""},{"iso_3166_1":"DE","title":"Das As der Asse","type":""},{"iso_3166_1":"GB","title":"Ace of Aces","type":""}],"externalIds":{"imdb_id":"tt0083580","wikidata_id":"Q560800","facebook_id":null,"instagram_id":null,"twitter_id":null},"keywords":[{"id":6075,"name":"sports"},{"id":190317,"name":"belmondo"}],"releaseDates":[{"iso_3166_1":"DE","release_dates":[{"certification":"12","descriptors":[],"iso_639_1":"","note":"","release_date":"1983-01-14T00:00:00.000Z","type":3}]},{"iso_3166_1":"DK","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1983-02-14T00:00:00.000Z","type":3}]},{"iso_3166_1":"FR","release_dates":[{"certification":"TP","descriptors":[],"iso_639_1":"","note":"","release_date":"1982-10-27T00:00:00.000Z","type":3}]},{"iso_3166_1":"HU","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1989-11-09T00:00:00.000Z","type":3}]},{"iso_3166_1":"NL","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1983-02-03T00:00:00.000Z","type":3}]},{"iso_3166_1":"NO","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1982-12-26T00:00:00.000Z","type":3}]},{"iso_3166_1":"PT","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1982-12-17T00:00:00.000Z","type":3}]},{"iso_3166_1":"SK","release_dates":[{"certification":"12","descriptors":[],"iso_639_1":"cs","note":"VOYO","release_date":"2025-04-09T00:00:00.000Z","type":4}]},{"iso_3166_1":"US","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1982-10-27T00:00:00.000Z","type":3}]}],"translations":[{"iso_639_1":"fr","iso_3166_1":"FR","name":"Français","english_name":"French","title":"","overview":"À l’occasion des Jeux Olympiques de Berlin de 1936, Georges dit « Jo », entraîneur de l’équipe française de boxe se rend en train dans la capitale accompagné de ses « poulains ». Il est abordé par un gosse de dix ans, Karl, un petit juif, qui le suit partout pour obtenir un autographe…","tagline":""},{"iso_639_1":"en","iso_3166_1":"US","name":"English","english_name":"English","title":"Ace of Aces","overview":"In this action comedy the French boxer Jo Cavalier is charmed on the train to Berlin for the Olympics in Hitler's Germany by the little boy Simon Rosenblum who asks his autograph; when it turns out his adorable young fan is a Jewish orphan in danger of persecution, he risks his one shot at Olympic glory to save Simon and his family, helped only by a German officer-gentleman who became his friend in World War I, by an adventurous escape to Switzerland, Nazi troops on their heals and braving impossible odds in roller coaster-style.","tagline":""},{"iso_639_1":"de","iso_3166_1":"DE","name":"Deutsch","english_name":"German","title":"Das As der Asse","overview":"Jo Cavalier, Trainer der französischen Boxmannschaft, die zur Berliner Olympiade von 1936 fährt, trägt den Spitznamen 'As der Asse'. Als ehemaliger Boxer und As der Jagdflieger im Ersten Weltkrieg lebt er jedoch nicht nur von der Erinnerung. Bei der Eröffnung der Olympiade trifft er einen alten Gegner der Lüfte und Freund über die Grenzen hinweg wieder, der jetzt als General zur Umgebung des 'Führers' gehört. Im Verlauf seines Aufenthaltes wird Jo in politische Abenteuer verwickelt, aus denen ihn nur sein Kumpel aus Kriegstagen und sein eigenes Geschick befreit.","tagline":""},{"iso_639_1":"cs","iso_3166_1":"CZ","name":"Český","english_name":"Czech","title":"Eso es","overview":"Jo Cavalier je trenérem francouzského národního boxerského týmu, který cestuje roku 1936 na Letní olympiádu do nacistického Německa. Jo se nejvíc těší na to, jak si to jeho chlapci rozdají s německými boxery přímo před tváří nacistických pohlavárů, mezi kterými nechybí ani Adolf Hitler. Pro svojí otevřenou a nespoutanou povahu se, samozřejmě, v diktátorském státě dostane téměř okamžitě do konfliktu s režimem.","tagline":""},{"iso_639_1":"ru","iso_3166_1":"RU","name":"Pусский","english_name":"Russian","title":"Ас из асов","overview":"Джо Кавалье, летчик-ас Первой Мировой войны, бывший боксер и тренер сборной Франции по боксу, отправляется на Олимпиаду 1936 года в Берлин. Обстоятельства складываются так, что он вынужден взять под свою защиту еврейского мальчика Симона Роземблюма и его многочисленную родню. Также судьба сталкивает его с очаровательной французской журналисткой…","tagline":""},{"iso_639_1":"zh","iso_3166_1":"CN","name":"普通话","english_name":"Mandarin","title":"王中王","overview":"故事发生在1936年希特勒统治下的德国。当年，就是在这个法西斯头子的淫威下，在德国柏林举办了世界奥林匹克运动会。法国拳击队教练乔治·加瓦利耶虽然痛恨德国法西斯，知道希特勒妄图利用奥运会的国际影响来为法西斯政权作宣传，但他不得不率领自己的队伍到柏林去参加拳击比赛。法国运动员乘坐由巴黎开往柏林的列车，一路上大家满怀必胜信心。加瓦利耶曾经是一个出色的拳击运动员，外号“王中王”。他本人曾经参加过第一次世界大战，担任过法国战斗机飞行员，击落过德军飞机，在法国名气很大。正是在这次大战中，他与一名德国空军军官甘特在空中交手，双方不分胜负。不打不相识。经过从空中到地面的较量，他们相互之间有了好感，成了好朋友。当时，他们都只有２５岁。世事变迁，但二人仍保持着友谊。在奥运会上他们又一次相遇了。在比赛中，甘特给加瓦利耶以大力支持，使法国拳击队赢得社会的广泛关注。不巧，一个犹太孩子卡尔在偶然的机会中出现了。由于他的家庭遭到德国法西斯的迫害，父亲的书店被查封捣毁，家人也不知去向。加瓦利耶和卡尔相遇，非常同情孩子的遭遇。为了解救卡尔一家，加瓦利耶在甘特的帮助下，与纳粹分子进行了错综复杂的周旋，经历了一次又一次惊险。最后，英勇无畏的加瓦利耶终于战胜了敌人，把卡尔一家护送出国境。","tagline":""},{"iso_639_1":"bg","iso_3166_1":"BG","name":"български език","english_name":"Bulgarian","title":"Асът на асовете","overview":"На път за олимпиадата в Берлин, френският боксьор Кавалие се запознава с малко момче, което се оказва негов голям фен. Оказва се още, че момчето е еврейско сираче и нацисткият режим го преследва. Кавалие решава да помогне на своя нов приятел без значение, че по този начин поставя на карта не само собствената си кариера, но и живота си!","tagline":""},{"iso_639_1":"es","iso_3166_1":"ES","name":"Español","english_name":"Spanish","title":"As de ases","overview":"Joe Cavalier (Jean-Paul Belmondo) fue uno de los más hábiles y valientes pilotos de la Primera Guerra Mundial (1914-1918). Veinte años después, es el entrenador de un equipo de púgiles franceses que participarán en las Olimpíadas de Berlín de 1936. Aprovechando la competición, Cavalier decide ayudar a escapar a un grupo de judíos, pero la falta de sentido de la orientación hace que el grupo se extravíe en la montaña.","tagline":""},{"iso_639_1":"it","iso_3166_1":"IT","name":"Italiano","english_name":"Italian","title":"L'asso degli assi","overview":"Jo e Gunther, dopo essersi combattuti nel corso della Prima guerra mondiale, diventano ottimi amici e si ritrovano alcuni anni dopo a Berlino durante le Olimpiadi del 1936. Nel frattempo Jo, diventato un famoso pugile, viene indotto, suo malgrado, a proteggere un bambino ebreo, i cui nonni sono perseguitati dai nazisti. La sua amicizia con Gunther, diventato generale del Reich, lo aiuterà a proteggere il ragazzo e i suoi familiari. Grazie all'aiuto dell'ufficiale lo spaccone Jo riesce a portare tutti al confine tra Austria e Svizzera. Ma un imprevisto rischai di mandare tutto a monte.","tagline":""},{"iso_639_1":"hu","iso_3166_1":"HU","name":"Magyar","english_name":"Hungarian","title":"Ászok ásza","overview":"Cavalier, az első világháborús francia vadászpilóta, mint ökölvívóedző a berlini olimpiára érkezik. A versenyen újra találkozik egykori háborús ellenfelével és barátjával, egy német repülős tiszttel. Amikor Cavalier megtudja, hogy egy zsidó család élete veszélyben forog, megkéri barátját, hogy segítsen kimenekíteni őket a náci Németországból. A mentőeszköz természetesen nem lehet más, mint egy repülőgép.","tagline":""},{"iso_639_1":"nl","iso_3166_1":"NL","name":"Nederlands","english_name":"Dutch","title":"L'As des As","overview":"Jo is een oud-bokser, die in 1917 zevenendertig Duitse vliegtuigen neerhaalde en daardoor de bijnaam 'Aas der Azen' kreeg. Met zijn tegen- stander Gunther von Beckmann raakt hij bevriend. Na vele jaren ziet hij die terug tijdens de opening van de Olympische spelen in Berlijn. Een tweede onverwachte ontmoeting met een tienjarige Berlijnse weesjongen, die een fan van Jo blijkt te zijn, zorgt dat het avonturenbloed weer gaat borrelen. Want Jo wil de weesjongen vanuit nazi-Berlijn weer naar Oostenrijk brengen. Het lukt hem met de hulp van zijn vriend Gunter, nu generaal Von Beckmann, die hij meesleept in chaotische achtervolgingen en riskante situaties.","tagline":""},{"iso_639_1":"tr","iso_3166_1":"TR","name":"Türkçe","english_name":"Turkish","title":"Asların Ası","overview":"Ünlü Fransız aktör Jean Paul Belmondo'dan müthiş bir kara komedi. Cavalier, iki ülke arasındaki düşmanlığa verilen yirmi yıllık aradan sonra, 1936 Berlin olimpiyatlarına Fransız boks milli takımının antrenörü olarak katılır. Ancak gelişmeler onu bir grup yahudi mültecinin kurtarıcısı haline getirecektir.","tagline":""},{"iso_639_1":"pl","iso_3166_1":"PL","name":"Polski","english_name":"Polish","title":"As nad asy","overview":"Rok 1936. Jo Cavalier, pilot myśliwca z czasów pierwszej wojny światowej, przybywa na olimpiadę do Berlina jako trener francuskiej reprezentacji bokserskiej. Tutaj przypadkiem ratuje żydowskiego chłopca, młodego sportowca, i jego rodzinę. Organizuje im ucieczkę z Niemiec, a pomaga mu w tym dawny wróg, z którym stoczył walkę powietrzną, niemiecki pilot Gunther von Beckmann.","tagline":""},{"iso_639_1":"el","iso_3166_1":"GR","name":"ελληνικά","english_name":"Greek","title":"Ο άσσος των άσσων","overview":"Ενας πρώην πιλότος και πρώην μποξέρ φτάνει στο Βερολίνο σαν προπονητής της γαλλικής ομάδας του μποξ στους Ολυμπιακούς του 1936 και έρχεται αντιμετωπος με το πραγματικό πρόσωπο τ ου ναζισμού που κυριαρχεί πίσω από τη φαντασμαγορική ατμόσφαιρα των αγώνων.","tagline":""},{"iso_639_1":"pt","iso_3166_1":"BR","name":"Português","english_name":"Portuguese","title":"O Ás dos Ases","overview":"","tagline":""},{"iso_639_1":"uk","iso_3166_1":"UA","name":"Український","english_name":"Ukrainian","title":"Ас із асів","overview":"Джо Кавальє, льотчик- ас Першої світової війни, що був боксером і тренером збірної Франції з боксу, відправляється на Олімпіаду 1936 року в Берлін.\r Обставини складаються так, що він змушений взяти під свій захист єврейського хлопчика Симона і його численну рідню. Також доля зіштовхує його із чарівною французькою журналісткою…","tagline":""},{"iso_639_1":"ja","iso_3166_1":"JP","name":"日本語","english_name":"Japanese","title":"エースの中のエース","overview":"","tagline":""},{"iso_639_1":"fi","iso_3166_1":"FI","name":"suomi","english_name":"Finnish","title":"Ässien ässä","overview":"","tagline":""},{"iso_639_1":"sk","iso_3166_1":"SK","name":"Slovenčina","english_name":"Slovak","title":"Eso es","overview":"Jo Cavalier je trénerom francúzskeho národného boxerského tímu, ktorý cestuje do nacistického Nemecka na letné olympijské hry 1936. Jo sa najviac teší na to, ako jeho chlapci nastúpia proti nemeckým boxerom pred očami nacistických vodcov vrátane Adolfa Hitlera. Samozrejme, pre svoju otvorenú a nespútanú povahu sa takmer okamžite dostane do konfliktu s režimom v diktátorskom štáte.","tagline":""},{"iso_639_1":"ca","iso_3166_1":"ES","name":"Català","english_name":"Catalan","title":"Campió de campions","overview":"","tagline":""},{"iso_639_1":"ro","iso_3166_1":"RO","name":"Română","english_name":"Romanian","title":"Asul așilor","overview":"","tagline":""}],"videos":[{"key":"Ps6Kn3aMffo","site":"YouTube","type":"Clip","name":"L'As des As (1982 ) - Prends le volant p'tit","iso_639_1":"fr","official":false,"published_at":"2016-01-16T17:47:32.000Z","size":720},{"key":"4MPJTjFlvSQ","site":"YouTube","type":"Clip","name":"L'As des As (1982) - Parachute","iso_639_1":"fr","official":false,"published_at":"2016-01-16T17:44:26.000Z","size":720},{"key":"V1rXJ_nUODE","site":"YouTube","type":"Clip","name":"L'As des As (1982)  - Beethoven","iso_639_1":"fr","official":false,"published_at":"2016-01-16T17:42:13.000Z","size":720},{"key":"mL7wC3vQWF8","site":"YouTube","type":"Clip","name":"L'As des As (1982) - Avec un K comme Kaput","iso_639_1":"fr","official":false,"published_at":"2016-01-16T17:41:43.000Z","size":720},{"key":"Lw2gUcTZnFw","site":"YouTube","